#!/bin/bash
# Install the last debug APK. The default path does not compile.
# Agents must not run this (AGENT_MANDATES.md). There is no works tag here.

set -euo pipefail

# One debug APK per ABI flavor (app/build.gradle.kts productFlavors); each device gets its own.
apk_for_abi() {
  case "$1" in
    arm64-v8a) echo "app/build/outputs/apk/arm64/debug/app-arm64-debug.apk" ;;
    x86_64) echo "app/build/outputs/apk/x86_64/debug/app-x86_64-debug.apk" ;;
  esac
}
APK="$(apk_for_abi x86_64)"

# The app id comes from one place: the APK being installed, read with the SDK aapt2 that
# build_app uses (ve_aapt2_from_sdk, sdk.dir in local.properties). Nothing is hard-coded and
# there is no other source; if it cannot be read, deploy stops.
_DEPLOY_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$_DEPLOY_HERE/ve-resolve-orch" ]; then
  echo "ERROR: $_DEPLOY_HERE/ve-resolve-orch missing (needed to locate the SDK aapt2)" >&2
  exit 1
fi
# shellcheck source=/dev/null
. "$_DEPLOY_HERE/ve-resolve-orch"
AAPT2=""
apk_package() {
  local apk="$1" out
  if [ -z "$AAPT2" ]; then
    AAPT2=$(ve_aapt2_from_sdk "$_DEPLOY_HERE") || { echo "ERROR: cannot locate SDK aapt2 to read the app id of $apk" >&2; return 1; }
  fi
  if ! out=$("$AAPT2" dump packagename "$apk"); then
    echo "ERROR: $AAPT2 dump packagename $apk failed; cannot determine the app id" >&2
    return 1
  fi
  if ! [[ "$out" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+$ ]]; then
    echo "ERROR: $AAPT2 dump packagename $apk printed '$out', not one application id" >&2
    return 1
  fi
  printf '%s\n' "$out"
}

# True when package $2 is installed on device $1 (exact name; pm list filters by substring).
pkg_installed() {
  local list
  if ! list=$(adb -s "$1" shell pm list packages "$2"); then
    echo "ERROR: adb -s $1 shell pm list packages $2 failed" >&2
    return 2
  fi
  printf '%s\n' "$list" | tr -d '\r' | grep -qx -- "package:$2"
}

usage() {
  cat <<'EOF'
Usage: ./deploy [-h|--help] [--clean] [--rebuild] [device...] [-- gradle-flag...]

Install the per-ABI debug APK (app/build/outputs/apk/<abi>/debug/app-<abi>-debug.apk;
arm64 or x86_64, chosen by each device's ro.product.cpu.abi) with adb install -r.
The app id is read from that APK (SDK aapt2 dump packagename); deploy stops if it
cannot be read, if the two ABI APKs name different apps, or if the app is not
installed under that id afterwards. The default path does not recompile. When every
selected install succeeds, move deployed (deployed on master, otherwise
<branch>/deployed).

  -h, --help   Print this usage and exit
  --clean      Uninstall the APK's own app id before install (UNINSTALL_FIRST=1).
               Uninstall removes that app's data; no other package is touched.
               An app that is not installed is reported and skipped; a failed
               uninstall stops that device.
  --rebuild    Call ./build_app once before install (REBUILD=1).
               Gradle flags after -- are passed to ./build_app.
  tablet, emulator
               Select emulator-5554. Any other device argument is an adb serial.

With no device arguments, install on every adb devices row whose state
is device. If the APK is missing, run ./build_app to produce it.
EOF
}

rebuild=0
if [ "${REBUILD:-0}" = "1" ]; then
  rebuild=1
fi
uninstall_first=0
if [ "${UNINSTALL_FIRST:-0}" = "1" ]; then
  uninstall_first=1
fi

device_args=()
gradle_flags=()
seen_dd=0
help=0
unknown=""

for arg in "$@"; do
  if [ "$seen_dd" -eq 1 ]; then
    gradle_flags+=("$arg")
    continue
  fi
  case "$arg" in
    --)
      seen_dd=1
      ;;
    -h|--help)
      help=1
      ;;
    --clean)
      uninstall_first=1
      ;;
    --rebuild)
      rebuild=1
      ;;
    -*)
      if [ -z "$unknown" ]; then
        unknown=$arg
      fi
      ;;
    *)
      device_args+=("$arg")
      ;;
  esac
done

if [ "$help" -eq 1 ]; then
  usage
  exit 0
fi
if [ -n "$unknown" ]; then
  echo "ERROR: unknown flag: $unknown" >&2
  usage
  exit 1
fi
if [ "$rebuild" -ne 1 ] && [ "${#gradle_flags[@]}" -gt 0 ]; then
  echo "ERROR: gradle flags require --rebuild" >&2
  usage
  exit 1
fi

if [ "$rebuild" -eq 1 ]; then
  if [ "${#gradle_flags[@]}" -gt 0 ]; then
    ./build_app -- "${gradle_flags[@]}"
  else
    ./build_app
  fi
fi

if [ ! -f "$APK" ] && [ ! -f "$(apk_for_abi arm64-v8a)" ]; then
  echo "ERROR: missing $APK and $(apk_for_abi arm64-v8a)" >&2
  echo "Run ./build_app to produce it." >&2
  exit 1
fi

# One app id for this deploy: every ABI APK present must name the same app.
PKG=""
for _abi in arm64-v8a x86_64; do
  _apk="$(apk_for_abi "$_abi")"
  [ -f "$_apk" ] || continue
  _pkg=$(apk_package "$_apk") || exit 1
  if [ -z "$PKG" ]; then
    PKG="$_pkg"; PKG_FROM="$_apk"
  elif [ "$_pkg" != "$PKG" ]; then
    echo "ERROR: $PKG_FROM is $PKG but $_apk is $_pkg; rebuild (./build_app) so both name the same app" >&2
    exit 1
  fi
done
echo "App id: $PKG (from $PKG_FROM)"

if ! devices_text=$(adb devices); then
  echo "ERROR: adb devices failed" >&2
  exit 1
fi

connected=()
while read -r serial state _; do
  serial=${serial//$'\r'/}
  state=${state//$'\r'/}
  if [ "$state" = "device" ]; then
    connected+=("$serial")
  fi
done <<< "$devices_text"

map_serial() {
  case "$1" in
    tablet|emulator) printf '%s' "emulator-5554" ;;
    *) printf '%s' "$1" ;;
  esac
}

selected=()
add_selected() {
  local s
  for s in "${selected[@]}"; do
    [ "$s" = "$1" ] && return 0
  done
  selected+=("$1")
}

if [ "${#device_args[@]}" -eq 0 ]; then
  for serial in "${connected[@]}"; do
    add_selected "$serial"
  done
else
  for name in "${device_args[@]}"; do
    add_selected "$(map_serial "$name")"
  done
fi

if [ "${#selected[@]}" -eq 0 ]; then
  echo "ERROR: no devices in the device state" >&2
  exit 1
fi

is_connected() {
  local s
  for s in "${connected[@]}"; do
    [ "$s" = "$1" ] && return 0
  done
  return 1
}

failed=0
for serial in "${selected[@]}"; do
  if ! is_connected "$serial"; then
    echo "ERROR: $serial is not in the device state" >&2
    failed=1
    continue
  fi

  if ! abi=$(adb -s "$serial" shell getprop ro.product.cpu.abi); then
    echo "ERROR: could not read ro.product.cpu.abi on $serial" >&2
    failed=1
    continue
  fi
  abi=$(printf '%s' "$abi" | tr -d '[:space:]')
  case "$abi" in
    arm64-v8a|x86_64) ;;
    *)
      echo "ERROR: $serial ABI '$abi' is not arm64-v8a or x86_64" >&2
      failed=1
      continue
      ;;
  esac

  APK="$(apk_for_abi "$abi")"
  if [ ! -f "$APK" ]; then
    echo "ERROR: missing $APK for $serial ($abi); run ./build_app" >&2
    failed=1
    continue
  fi

  if [ "$uninstall_first" -eq 1 ]; then
    if pkg_installed "$serial" "$PKG"; then
      if ! adb -s "$serial" uninstall "$PKG"; then
        echo "ERROR: adb uninstall $PKG failed on $serial" >&2
        failed=1
        continue
      fi
    else
      rc=$?
      if [ "$rc" -ne 1 ]; then failed=1; continue; fi
      echo "$PKG is not installed on $serial; nothing to uninstall"
    fi
  fi

  if ! adb -s "$serial" install -r "$APK"; then
    echo "ERROR: adb install -r failed on $serial" >&2
    failed=1
    continue
  fi
  if ! pkg_installed "$serial" "$PKG"; then
    echo "ERROR: after installing $APK, $PKG is not installed on $serial (app id mismatch)" >&2
    failed=1
    continue
  fi

  if ! adb -s "$serial" logcat -c; then
    echo "WARNING: adb logcat -c failed on $serial" >&2
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "ERROR: one or more devices failed; deployed tag left unchanged" >&2
  exit 1
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" == "master" ]; then
  TAG_NAME="deployed"
else
  TAG_NAME="${CURRENT_BRANCH}/deployed"
fi
echo "Install successful. Updating '$TAG_NAME' tag."
git tag -f "$TAG_NAME"
git describe --tags --always
exit 0
