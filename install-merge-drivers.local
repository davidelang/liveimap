#!/bin/bash
# install-merge-drivers.local: liveimap-owned; run last by install-merge-drivers.sh.
# Sets the settings-tree clean filter used by .gitattributes for
# app/src/main/assets/settings-tree.json. Never written by deploy-orchestration.
set -euo pipefail
git config filter.settings-tree.clean "./settings-tree-filter clean"
git config filter.settings-tree.required true
# chmod is owner-only. Already-executable scripts still install.
if ! chmod +x ./settings-tree-filter ./settings-tree-collapse; then
  if [ ! -x ./settings-tree-filter ] || [ ! -x ./settings-tree-collapse ]; then
    echo "install-merge-drivers.local: filter scripts are not executable" >&2
    exit 1
  fi
fi
echo "  filter.settings-tree.clean=$(git config --get filter.settings-tree.clean)"
echo "  filter.settings-tree.required=$(git config --get filter.settings-tree.required)"
