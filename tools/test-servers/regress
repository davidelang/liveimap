def mutf7(text):
    out, buf = [], ""

    def flush():
        nonlocal buf
        if buf:
            out.append("&" + base64.b64encode(buf.encode("utf-16-be")).decode().rstrip("=").replace("/", ",") + "-")
            buf = ""

    for ch in text:
        if 0x20 <= ord(ch) <= 0x7e:
            flush()
            out.append("&-" if ch == "&" else ch)
        else:
            buf += ch
    flush()
    return "".join(out)


def read_seed_table(name):
    path = os.path.join(HERE, "seed", name)
    with open(path, newline="", encoding="utf-8") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


def imap_auth(mail, user, password):
    """LOGIN for ASCII credentials; AUTHENTICATE PLAIN (UTF-8) otherwise, since imaplib LOGIN is ASCII only."""
    if (user + password).isascii():
        mail.login(user, password)
    else:
        mail.authenticate("PLAIN", lambda _c: ("\0" + user + "\0" + password).encode("utf-8"))


def imap_quote(name):
    return '"' + name.replace("\\", "\\\\").replace('"', '\\"') + '"'


def legacy_tls_servers():
    """Servers listed in legacy-tls.tsv (column 1)."""
    with open(os.path.join(HERE, "legacy-tls.tsv"), encoding="utf-8") as handle:  # missing file: fail loudly
        return {line.split("\t")[0] for line in handle if line.strip() and not line.startswith("#")}


def imap_login(host, port, user, password, server=""):
    ctx = ssl.create_default_context(cadata=open(os.path.join(HERE, "generated", "ca", "ca.der"), "rb").read())
    ctx.check_hostname = False
    if server in legacy_tls_servers():
        ctx.set_ciphers("DEFAULT:@SECLEVEL=0")  # legacy-tls.tsv: this server offers only legacy ciphers; CA pin stays
    last = ""
    for starttls in (False, True):
        try:
            mail = imaplib.IMAP4(host, port, timeout=30)
            if starttls:
                mail.starttls(ssl_context=ctx)
            imap_auth(mail, user, password)
            return mail, ""
        except Exception as exc:
            last = str(exc)
    return None, last


def listed_names(mail):
    typ, data = mail.list()
    found = set()
    delim = "/"
    if typ != "OK":
        return found, delim
    for row in data or []:
        if not row:
            continue
        line = row.decode("utf-8", "replace") if isinstance(row, bytes) else str(row)
        parts = line.split('"')
        if len(parts) >= 3 and len(parts[1]) == 1:
            delim = parts[1]
            if len(parts) > 3:
                found.add(parts[-2])
            else:
                name = parts[-1].strip()
                if name:
                    found.add(name)
        else:
            bits = line.split()
            if bits:
                found.add(bits[-1])
    return found, delim


def mailbox_for(folder, user, delim, found):
    if folder == "INBOX":
        cands = ["INBOX"]
    else:
        enc = mutf7(folder.replace("/", delim))
        cands = [
            enc,
            "INBOX" + delim + enc,
            "user" + delim + user + delim + enc,
        ]
    for cand in cands:
        if cand in found:
            return cand
    return ""


SERVER_SET_FLAGS = ("\\recent", "$hasattachment", "$hasnoattachment", "$junk", "junk", "junkrecorded")


def flag_key(words):
    # \Recent is session state; $HasAttachment/$HasNoAttachment (RFC 8457) are computed by the server
    # (Dovecot attachment detection), and $Junk/Junk/JunkRecorded are set by Zimbra on messages in Junk;
    # none of them are seeded. The corpus never sets any of these words.
    kept = [w for w in words if w.lower() not in SERVER_SET_FLAGS]
    return tuple(sorted(kept, key=str.lower))


def fetched_messages(mail):
    typ, data = mail.uid("fetch", "1:*", "(UID FLAGS BODY.PEEK[])")
    if typ != "OK" or not data or data == [None]:
        return []
    # imaplib yields (meta, literal) tuples; items after a literal (Zimbra: b' FLAGS (...))') belong to it.
    joined = []
    for item in data:
        if item is None or item == b")":
            continue
        if isinstance(item, tuple):
            joined.append([item[0], item[1] if len(item) > 1 else b""])
        elif joined and not re.match(rb"\s*\d+ \(", item):
            joined[-1][0] = joined[-1][0] + b" " + item
        else:
            joined.append([item, b""])
    msgs = []
    for meta, body in joined:
        meta_s = meta.decode("utf-8", "replace") if isinstance(meta, bytes) else str(meta)
        uid_m = re.search(r"\bUID (\d+)", meta_s)
        flags_m = re.search(r"FLAGS \(([^)]*)\)", meta_s)
        uid = int(uid_m.group(1)) if uid_m else 0
        flags = flags_m.group(1).split() if flags_m else []
        if not isinstance(body, (bytes, bytearray)):
            body = str(body).encode()
        body = bytes(body).replace(b"\r\n", b"\n").replace(b"\n", b"\r\n")
        msgs.append((uid, flags, body))
    msgs.sort(key=lambda row: row[0])
    return msgs


def verify_one(s, skipped):
    """Folder counts, flags, and corpus-v1.sums. Returns (blocked, drift lines)."""
    import lab
    server = s["name"]
    accounts = {row["user"]: row["password"] for row in read_seed_table("accounts.tsv")}
    folders = [row for row in read_seed_table("folders.tsv")]
    sums = {}
    for line in open(os.path.join(HERE, "seed", "corpus-v1.sums"), encoding="utf-8"):
        fields = line.rstrip("\n").split("\t")
        if len(fields) >= 4:
            sums[(fields[0], fields[1])] = fields[3]
    manifest = os.path.join(HERE, "generated", "corpus-v1", "manifest.tsv")
    flags_by = {}
    with open(manifest, newline="", encoding="utf-8") as handle:
        for row in csv.DictReader(handle, delimiter="\t"):
            words = [] if row.get("flags") == "-" else (row.get("flags") or "").split()
            flags_by.setdefault((row["user"], row["folder"]), []).append(flag_key(words))
    problems = []
    users = []
    for row in folders:
        if row["user"] not in users:
            users.append(row["user"])
    for user in users:
        password = accounts.get(user, "")
        login_user = user + "@zimbra.zcs-foss.test" if server == "zimbra-883" else user
        mail, err = imap_login(lab.LAB_HOST, s["imap"], login_user, password, server)
        if mail is None:
            problems.append(f"{server} INBOX: login failed")
            continue
        try:
            found, delim = listed_names(mail)
            for row in folders:
                if row["user"] != user:
                    continue
                folder = row["folder"]
                label = f"{server} {folder}"
                box = mailbox_for(folder, user, delim, found)
                if not box:
                    problems.append(f"{label}: missing")
                    continue
                typ, data = mail.select(imap_quote(box), readonly=True)
                if typ != "OK":
                    problems.append(f"{label}: missing")
                    continue
                try:
                    got_count = int(data[0])
                except (TypeError, ValueError, IndexError):
                    got_count = -1
                want_count = int(row["count"])
                if got_count != want_count:
                    problems.append(f"{label}: count {got_count} != {want_count}")
                msgs = fetched_messages(mail) if got_count else []
                want_flags = flags_by.get((user, folder), [])
                got_flags = [flag_key(flags) for _uid, flags, _body in msgs]
                if sorted(got_flags) != sorted(want_flags):
                    problems.append(f"{label}: flags")
                joined = "\n".join(hashlib.sha256(body).hexdigest() for _uid, _flags, body in msgs)
                digest = hashlib.sha256(joined.encode()).hexdigest()
                want_digest = sums.get((user, folder), "")
                if digest != want_digest:
                    problems.append(f"{label}: corpus-v1.sums")
        finally:
            try:
                mail.logout()
            except Exception:
                pass
    suite = lab.fixture_check(s)  # the suite boxes (LiveIMAP-Test, Sub, Trash, Deep, Spoof) are part of the seed too
    if suite:
        problems.append(f"{server} {suite}")
    if skipped:
        return "", [f"drift: {line}" for line in problems]
    if problems:
        return problems[0], []
    return "", []


