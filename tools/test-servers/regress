def start_lab_container(s, skip=False):
    """Stop every other liveimap-* container, start this one, and run its up command."""
    import lab
    cont = s["container"]
    lab.only_one(cont)
    if not skip:
        err = reset_lab_server(s)
        if err:
            return err
    if container_running(cont):
        r = subprocess.run(["docker", "stop", "-t", "20", cont], capture_output=True, text=True, errors="replace")
        if r.returncode != 0 or container_running(cont):
            return first_line(r.stderr or r.stdout)
    r = subprocess.run(["docker", "start", cont], capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return snapshot_line(r.stderr or r.stdout) or first_line(r.stderr or r.stdout)
    if not container_running(cont):
        text = container_logs(cont)
        return snapshot_line(text) or first_line(text)
    upcmd = lab.up_commands().get(cont)
    if upcmd:
        r = subprocess.run(["docker", "exec", cont, "sh", "-c", upcmd], capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            text = (r.stderr or "") + "\n" + (r.stdout or "")
            return snapshot_line(text) or first_line(text)
        if not container_running(cont):
            text = container_logs(cont)
            return snapshot_line(text) or first_line(text)
    n = 900 if cont in lab.ALONE else 300
    deadline = time.time() + n
    while time.time() < deadline:
        if not container_running(cont):
            text = container_logs(cont)
            return snapshot_line(text) or first_line(text)
        if lab.greeting(s["imap"], False, timeout=1):
            break
    else:
        if not container_running(cont):
            text = container_logs(cont)
            return snapshot_line(text) or first_line(text)
        return f"no IMAP greeting after {n}s"
    time.sleep(5)
    return ""


