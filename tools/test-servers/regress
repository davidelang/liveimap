def read_tsv_rows(path, width):
    out = []
    if not os.path.exists(path):
        return out
    for line in open(path, encoding="utf-8", errors="replace"):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.rstrip("\n").split("\t")
        if len(f) >= width:
            out.append(f)
    return out


def docker_port(container, cport):
    r = subprocess.run(["docker", "port", container, str(cport)], capture_output=True, text=True, errors="replace")
    line = (r.stdout or "").split("\n")[0].strip()
    hp = line.rsplit(":", 1)[-1].strip() if line else ""
    if hp.isdigit():
        return int(hp), ""
    return 0, first_line(r.stderr or r.stdout or "no mapped port")


def imap_greeting(host, port):
    try:
        c = socket.create_connection((host, port), 5)
        c.settimeout(5)
        g = c.recv(200)
        c.close()
    except Exception as e:
        return first_line(str(e))
    if g.startswith(b"* OK") or g.startswith(b"* PREAUTH"):
        return ""
    return first_line(g.decode("utf-8", "replace"))


def smtp_banner(host, port):
    try:
        c = socket.create_connection((host, port), 5)
        c.settimeout(5)
        g = c.recv(200)
        c.close()
    except Exception as e:
        return first_line(str(e))
    if g.startswith(b"220"):
        return ""
    return first_line(g.decode("utf-8", "replace"))


def sieve_greeting(host, port):
    try:
        c = socket.create_connection((host, port), 5)
        c.settimeout(5)
        g = c.recv(200)
        c.close()
    except Exception as e:
        return first_line(str(e))
    if g.strip():
        return ""
    return "empty sieve greeting"


def jmap_session(host, port, scheme):
    url = f"{scheme}://{host}:{port}/.well-known/jmap"
    try:
        ctx = ssl._create_unverified_context() if scheme == "https" else None
        import base64
        import lab
        req = urllib.request.Request(url, headers={"Authorization": "Basic " + base64.b64encode(
            (lab.USER + ":" + lab.PASS).encode("utf-8")).decode()})  # Cyrus answers the session only when authenticated
        with urllib.request.urlopen(req, context=ctx, timeout=8) as resp:
            body = resp.read(4000)
    except Exception as e:
        return first_line(str(e))
    if b"apiUrl" in body or b"capabilities" in body:
        return ""
    return "not a JMAP session"


