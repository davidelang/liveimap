def run_imap(names, variants, force):
    mark_suite_started()
    env = child_env()
    if variants:
        env["ACC_VARIANTS"] = variants
    variant_key = variants or ""
    for name in names:
        write_lock(f"suite imap {name}")
        if not force and cache_pass("imap", name, variant_key):
            record_cached("imap", name, variant_key)
            continue
        if not reset_or_fail("imap", name, "reset"):
            continue
        t0 = time.time()
        rc, text = run_cmd([sys.executable, os.path.join(HERE, "acclab.py"), name, "auto", run_id],
                           f"imap-{name}.log", env)
        duration = int(time.time() - t0)
        parsed = acceptance_rows(name, run_id)
        if not parsed:
            m = re.search(r"# summary:\s*(\d+) pass,\s*(\d+) fail,\s*(\d+) skip", text)
            status = "FAIL" if rc != 0 or "\nFAIL" in "\n" + text or text.strip().endswith("FAIL") else "PASS"
            if m and int(m.group(2)) > 0:
                status = "FAIL"
            counts = {"pass": int(m.group(1)) if m else (1 if status == "PASS" else 0),
                      "fail": int(m.group(2)) if m else (1 if status == "FAIL" else 0),
                      "skip": int(m.group(3)) if m else 0, "known": 0}
            err = "" if status == "PASS" else redact(first_line(text))
            add_row(name, "imap", variant_key, counts, status, "" if status == "PASS" else "acceptance", err, duration)
            cache_store("imap", name, variant_key, status, counts)
            continue
        by = {}
        for item in parsed:
            by.setdefault(item["variant"], []).append(item)
        server_fail = False
        for variant, items in by.items():
            counts = {"pass": 0, "fail": 0, "skip": 0, "known": 0}
            failing, err = "", ""
            for item in items:
                if item["result"] == "pass":
                    counts["pass"] += 1
                elif item["result"] == "fail":
                    counts["fail"] += 1
                    if not failing:
                        failing, err = item["check"], item["detail"]
                elif item["result"] == "skip":
                    counts["skip"] += 1
                else:
                    counts["known"] += 1
            status = "FAIL" if counts["fail"] else "PASS"
            if status == "FAIL":
                server_fail = True
            add_row(name, "imap", variant, counts, status, failing, err, duration)
            cache_store("imap", name, variant, status, counts)
        overall = "FAIL" if server_fail or rc != 0 else "PASS"
        if not variant_key:
            total = {"pass": 0, "fail": 0, "skip": 0, "known": 0}
            for item in parsed:
                key = "pass" if item["result"] == "pass" else "fail" if item["result"] == "fail" else "skip" if item["result"] == "skip" else "known"
                total[key] += 1
            cache_store("imap", name, "", overall, total)
        elif overall == "PASS":
            cache_store("imap", name, variant_key, "PASS", {"pass": 1, "fail": 0, "skip": 0, "known": 0})


def host_env_value(key):
    """One key from tools/test-servers/host.env. Empty when the file or the key is absent."""
    path = os.path.join(HERE, "host.env")
    if not os.path.isfile(path):
        return ""
    for line in open(path, encoding="utf-8", errors="replace"):
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        name, value = stripped.split("=", 1)
        if name.strip() == key:
            return value.strip().strip('"').strip("'")
    return ""


def imap_idle_steps():
    """idle, idleRenew, tlsUntrusted, preservedSecurityLine, plus tlsNameMismatch when LAB_ALT_HOST is set."""
    steps = ["idle", "idleRenew", "tlsUntrusted", "preservedSecurityLine"]
    alt = host_env_value("LAB_ALT_HOST")
    if alt:
        steps.append("tlsNameMismatch")
    return steps, alt


def run_lab_suite(suite, names, args, checks, force, mech=False, extra_env=None):
    mark_suite_started()
    todo = []
    for name in names:
        if not force and cache_pass(suite, name, ""):
            record_cached(suite, name, "")
        else:
            todo.append(name)
    if not todo:
        return
    write_lock(f"suite {suite}")
    todo = [name for name in todo if reset_or_fail(suite, name, checks[0] if checks else suite)]
    if not todo:
        return
    cmd = [sys.executable, os.path.join(HERE, "lab.py"), "run", "--skip-install", "--commit", commit, "--steps", args]
    if mech:
        cmd.append("--mechs")
    for name in todo:
        cmd.extend(["--server", name])
    t0 = time.time()
    rc, text = run_cmd(cmd, f"{suite}.log", child_env(extra_env))
    duration = int(time.time() - t0)
    parsed = parse_lab_summary(text)
    by = {}
    for row in parsed:
        by.setdefault(row["server"], []).append(row)
    for name in todo:
        server_rows = by.get(name, [])
        if not server_rows:
            err = redact(first_line(text)) if rc != 0 else "no lab result"
            add_row(name, suite, "", counts_for("FAIL"), "FAIL", checks[0] if checks else suite, err, duration)
            cache_store(suite, name, "", "FAIL", counts_for("FAIL"))
            continue
        per_check = {check: ("skip", "") for check in checks}
        mech_results = {}
        seconds = 0
        for row in server_rows:
            seconds += row["seconds"]
            steps = steps_for(row)
            proto = row["protocol"]
            if mech and "/" in proto:
                mechanism = proto.split("/", 1)[1]
                res, detail = step_status(steps, "open", row["result"])
                if "open" not in steps and row["result"] == "pass":
                    res, detail = "ok", ""
                elif "open" not in steps and row["result"] == "fail":
                    res, detail = "fail", row["detail"]
                prev = mech_results.get(mechanism)
                status = classify(mechanism, "imap-mechs", "open", res, detail)
                if prev is None or RANK[status] > RANK[prev[0]]:
                    mech_results[mechanism] = (status, detail if status in ("FAIL", "unexpected pass", "KNOWN") else "")
            else:
                for check in checks:
                    res, detail = step_status(steps, check, row["result"])
                    if row["result"] == "fail" and check not in steps and not steps:
                        res, detail = "fail", row["detail"]
                    status = classify(name, suite, check, res, detail)
                    prev = per_check.get(check, ("SKIP", ""))
                    if RANK[status] >= RANK.get(prev[0], 0):
                        per_check[check] = (status, detail if status in ("FAIL", "unexpected pass", "KNOWN") else "")
        if mech:
            if not mech_results:
                add_row(name, suite, "", counts_for("FAIL"), "FAIL", "open", "no mechanism result", seconds or duration)
                cache_store(suite, name, "", "FAIL", counts_for("FAIL"))
                continue
            statuses = []
            for mechanism, (status, detail) in sorted(mech_results.items()):
                statuses.append(status)
                add_row(name, suite, mechanism, counts_for(status), status,
                        "open" if status in ("FAIL", "unexpected pass", "KNOWN") else "", detail, seconds or duration)
            overall = worst(statuses)
            cache_store(suite, name, "", "PASS" if overall == "PASS" else overall, counts_for(overall))
        else:
            # One row per check so a KNOWN idle step is not hidden by another step's FAIL.
            statuses = []
            for check in checks:
                status, detail = per_check[check]
                if status == "skip":
                    status = "SKIP"
                statuses.append(status)
                add_row(name, suite, check, counts_for(status), status,
                        check if status in ("FAIL", "unexpected pass", "KNOWN") else "",
                        detail, seconds or duration)
            overall = worst(statuses)
            cache_store(suite, name, "", "PASS" if overall == "PASS" else overall, counts_for(overall))


def jmap_steps(text):
    steps = {}
    for line in (text or "").splitlines():
        f = line.split("\t")
        if len(f) >= 2 and f[1] in ("ok", "fail") and f[0] not in ("step",):
            steps[f[0]] = (f[1], f[2] if len(f) > 2 else "")
    return steps


def jmap_result_line(name, text):
    for line in (text or "").splitlines():
        m = re.match(r"^" + re.escape(name) + r"\s+\S+\s+(OK|FAIL)\s*$", line.strip())
        if m:
            return m.group(1)
    return ""


def identity_failed(text):
    low = (text or "").lower()
    return any(k in low for k in ("identity create:", "identity lookup:", "no jmap identity", "empty identity", "notcreated"))


def run_jmap(names, force):
    mark_suite_started()
    wanted = [n for n in JMAP_SERVERS if n in names]
    for name in wanted:
        write_lock(f"suite jmap {name}")
        if not force and cache_pass("jmap", name, ""):
            record_cached("jmap", name, "")
            continue
        if not reset_or_fail("jmap", name, "reset"):
            continue
        t0 = time.time()
        rc, text = run_cmd([sys.executable, os.path.join(HERE, "jmaprun.py"), name, run_id],
                           f"jmap-{name}.log", child_env())
        duration = int(time.time() - t0)
        overall = jmap_result_line(name, text)
        steps = jmap_steps(text)
        statuses = []
        failing, err = "", ""
        up_check = ""
        total = {"pass": 0, "fail": 0, "skip": 0, "known": 0}
        seen = set()
        for check, (res, detail) in steps.items():
            seen.add(check)
            status = classify(name, "jmap", check, "ok" if res == "ok" else "fail", detail)
            if check == "submit" and known_match(name, "jmap", "identity") and identity_failed(text) and status == "FAIL":
                status = "KNOWN"
            statuses.append(status)
            bucket = {"PASS": "pass", "FAIL": "fail", "SKIP": "skip", "KNOWN": "known"}.get(status)
            if bucket:
                total[bucket] += 1
            if status == "FAIL" and not failing:
                failing, err = check, detail
            elif status == "unexpected pass" and not up_check:
                up_check = check
        # Empty identity stays KNOWN. No identity step and no identity_failed text is an unexpected pass.
        if known_match(name, "jmap", "identity") and "identity" not in seen and identity_failed(text):
            statuses.append("KNOWN")
            total["known"] += 1
            if not failing:
                failing = "identity"
        elif known_match(name, "jmap", "identity") and "identity" not in seen and not identity_failed(text):
            statuses.append("unexpected pass")
            if not up_check:
                up_check = "identity"
        if not overall and rc != 0:
            statuses.append("FAIL")
            total["fail"] += 1
            if not failing:
                failing, err = "jmap", first_line(text)
        if overall == "FAIL" and not any(s == "FAIL" for s in statuses):
            if not statuses:
                statuses.append("FAIL")
                total["fail"] += 1
                failing, err = failing or "jmap", first_line(text)
        if overall == "OK" and not statuses:
            statuses.append("PASS")
            total["pass"] += 1
        result = worst(statuses) if statuses else "FAIL"
        if result == "unexpected pass":
            failing = up_check
        if result == "FAIL" and not total["fail"]:
            total["fail"] = 1
        add_row(name, "jmap", "", total, result, failing, err, duration)
        cache_store("jmap", name, "", "PASS" if result == "PASS" else result, total)


