    if not cont:
        return
    subprocess.run(["docker", "stop", "-t", "20", cont], capture_output=True)


def teardown_server(s):
    """Stop and remove the server's copy-on-write container; the next setup or reset recreates it from its seed
    (start.sh --reset). '' or why not."""
    cont = s["container"]
    r = subprocess.run(["docker", "stop", "-t", "20", cont], capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return f"docker stop {cont}: {first_line(r.stderr or r.stdout)}"
    r = subprocess.run(["docker", "rm", cont], capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return f"docker rm {cont}: {first_line(r.stderr or r.stdout)}"
    return ""


def setup_server(name, s, by_name, suites):
    """Create [name] from its seed, start it and check it. '' or the BLOCKED reason; drift notes go to drift_lines."""
    import lab
    if s and s.get("container"):
        err = timed_step(f"{name} start", lambda: start_lab_container(s))
        if err:
            return f"{name}: {err}"
        err = timed_step(f"{name} check_published", lambda: lab.check_published(s["container"]))
        if err:
            return f"{name}: {err}"
    err = timed_step(f"{name} probe", lambda: probe_servers([name], by_name))
    if err:
        return err
    problem = timed_step(f"{name} login", lambda: domain_login_check(s))
    if problem:
        return f"{name} {problem} tools/test-servers/build-seed-image {name}"
    imap_port = s.get("imap") if isinstance(s, dict) else None
    problem = timed_step(f"{name} entry-version", lambda: lab.entry_version_problem(name, imap_port))
    if problem:
        return problem
    if "imap" in suites:
        problem = timed_step(f"{name} fixture", lambda: lab.fixture_check(s))
        if problem:
            return f"{name} {problem} tools/test-servers/build-seed-image {name}"
    blocked, drifted = timed_step(f"{name} verify-seed", lambda: verify_one(s, False), failed=lambda r: bool(r[0]))
    if blocked:
        return f"{blocked} tools/test-servers/build-seed-image {name}"
    drift_lines.extend(drifted)
    return ""


def block_server(name, suites, reason):
    """A setup failure: one loud line (even with --quiet) and a BLOCKED row per suite; the run goes on."""
    progress(f"BLOCKED {name} setup: {redact(reason)[:300]} (skipping {', '.join(suites)}; next server)")
    for suite in suites:
        add_row(name, suite, "", counts_for("BLOCKED"), "BLOCKED", "setup", reason, 0)
        done_units.add((name, suite))


