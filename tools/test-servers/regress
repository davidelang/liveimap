def source_address():
    r = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True, errors="replace")
    m = re.search(r"\bsrc\s+(\d+\.\d+\.\d+\.\d+)\b", r.stdout or "")
    if r.returncode != 0 or not m:
        return ""
    return m.group(1)


def load_secrets():
    found = []
    try:
        import lab
        if getattr(lab, "PASS", ""):
            found.append(lab.PASS)
    except Exception:
        pass
    path = os.path.join(HERE, "seed", "accounts.tsv")
    if os.path.exists(path):
        lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
        if lines:
            hdr = lines[0].split("\t")
            pi = hdr.index("password") if "password" in hdr else 1
            for line in lines[1:]:
                f = line.split("\t")
                if len(f) > pi and f[pi]:
                    found.append(f[pi])
    return [s for s in found if s]


def redact(text):
    text = "" if text is None else str(text)
    for secret in secrets:
        if secret and secret in text:
            text = text.replace(secret, "redacted")
    text = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "redacted", text)
    return text.replace("\n", " ").replace("|", "/").strip()


def first_line(text):
