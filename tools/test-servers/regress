def lab_mount_errors():
    """Any Mounts element on a liveimap-* container is one problem string."""
    import lab
    r = subprocess.run(["docker", "ps", "-a", "--format", "{{.Names}}"],
                       capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return [f"docker ps -a failed: {first_line(r.stderr or r.stdout)}"]
    names = sorted(n for n in (r.stdout or "").split() if n.startswith("liveimap-"))
    mounts_by_name = {}
    for cont in names:
        q = subprocess.run(["docker", "inspect", "-f", "{{json .Mounts}}", cont],
                           capture_output=True, text=True, errors="replace")
        if q.returncode != 0:
            return [f"{cont}: docker inspect failed: {first_line(q.stderr or q.stdout)}"]
        try:
            mounts_by_name[cont] = json.loads(q.stdout) or []
        except json.JSONDecodeError:
            return [f"{cont}: docker inspect failed: mounts were not json"]
    err = lab.mount_problems(names, mounts_by_name)
    if err:
        return [err]
    return []


def image_inspect(server):
    r = subprocess.run(["docker", "image", "inspect", "liveimap-seed-" + server],
                       capture_output=True, text=True, errors="replace")
    if r.returncode != 0 or not (r.stdout or "").strip():
        return None
    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None
    if not data:
        return None
    return data[0]


def published_ports():
    """container -> {container port: host port} for containers that exist. Does not start one."""
    r = subprocess.run(["docker", "ps", "-a", "--format", "{{.Names}}"],
                       capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return None
    existing = {n for n in (r.stdout or "").split() if n.startswith("liveimap-")}
    out = {}
    path = os.path.join(HERE, "servers.tsv")
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return None
    for line in text.splitlines():
        if not line.strip() or line.startswith("#"):
            continue
        fields = line.rstrip("\n").split("\t")
        if len(fields) < 3 or not fields[2].isdigit():
            continue
        cont = "liveimap-" + fields[0]
        if cont not in existing:
            continue
        cport = int(fields[2])
        # HostConfig.PortBindings, not `docker port`: lab containers are kept stopped, and `docker port` is empty then.
        proc = subprocess.run(["docker", "inspect", "-f", "{{json .HostConfig.PortBindings}}", cont],
                              capture_output=True, text=True, errors="replace")
        try:
            bindings = json.loads(proc.stdout or "null") or {}
        except ValueError:
            bindings = {}
        hp = str(((bindings.get("%d/tcp" % cport) or [{}])[0]).get("HostPort", "")) if proc.returncode == 0 else ""
        out.setdefault(cont, {})[cport] = hp if hp.isdigit() else "not published"
    return out


def dry_run_problems():
    """Cert, ports, seed images, then mounts. Empty when all four pass. Does not start a container."""
    import lab
    err = lab.cert_problem()
    if err:
        return "VERDICT BLOCKED " + err
    servers_path = os.path.join(HERE, "servers.tsv")
    ports_path = os.path.join(HERE, "generated", "local-ports.tsv")
    try:
        servers_text = open(servers_path, encoding="utf-8").read()
    except OSError:
        return "VERDICT BLOCKED cannot read " + servers_path
    try:
        ports_text = open(ports_path, encoding="utf-8").read()
    except OSError:
        return "VERDICT BLOCKED cannot read " + ports_path
    published = published_ports()
    if published is None:
        return "VERDICT BLOCKED docker ps -a failed"
    err = lab.port_problems(servers_text, ports_text, published)
    if err:
        return "VERDICT BLOCKED " + err
    for server in lab.SEED_SERVERS:
        err = lab.seed_problem(server, image_inspect(server))
        if err:
            return "VERDICT BLOCKED " + err
    bad = lab_mount_errors()
    if bad:
        return "VERDICT BLOCKED " + bad[0]
    return ""


