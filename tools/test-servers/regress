def counts_for(status):
    c = {"pass": 0, "fail": 0, "skip": 0, "known": 0}
    if status == "PASS":
        c["pass"] = 1
    elif status == "FAIL":
        c["fail"] = 1
    elif status == "SKIP":
        c["skip"] = 1
    elif status == "KNOWN":
        c["known"] = 1
    return c


def tsv_map(path):
    out = {}
    if not path or not os.path.isfile(path):
        return out
    lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    for line in lines[1:]:
        f = line.split("\t")
        if len(f) >= 2 and f[0] and f[0] != "step":
            out[f[0]] = (f[1], f[2] if len(f) > 2 else "")
    return out


def parse_lab_summary(text):
    path = ""
    for line in reversed((text or "").splitlines()):
        line = line.strip()
        if line.endswith("-summary.tsv") or line.endswith("summary.tsv"):
            path = line
            break
    parsed = []
    if path and os.path.isfile(path):
        for line in open(path, encoding="utf-8", errors="replace"):
            f = line.rstrip("\n").split("\t")
            if len(f) < 7 or f[0] == "server":
                continue
            parsed.append({
                "server": f[0], "protocol": f[1], "tls": f[2], "result": f[3],
                "detail": f[4], "seconds": int(f[5]) if f[5].isdigit() else 0, "dest": f[6],
            })
    return parsed


def steps_for(row):
    proto, mech = row["protocol"], ""
    if "/" in proto:
        mech = proto.split("/", 1)[1]
    run = f"{row['server']}-{row['tls']}" + (f"-{mech}" if mech else "")
    path = os.path.join(row["dest"], f"{run}.steps.tsv")
    got = tsv_map(path)
    if got:
        return got
    bad = re.search(r"bad=([^\s]+)", row["detail"] or "")
    if not bad:
        return {}
    return {name: ("fail", row["detail"]) for name in bad.group(1).split(",") if name}


def step_status(steps, check, summary_result):
    """A step the suite never ran (no IDLE, no sieve port) is a skip. A failed open is a fail."""
    if check in steps:
        res = steps[check][0]
        if res == "ok":
            return "ok", steps[check][1]
        return "fail", steps[check][1]
    if summary_result in ("skip", "assumption", "pass", "expected"):
        return "skip", "step not run"
    if "open" in steps and steps["open"][0] != "ok":
        return "fail", steps["open"][1]
    if summary_result == "fail":
        return "fail", ""
    return "skip", "step not run"


