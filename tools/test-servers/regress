def cache_key(suite, server, variant):
    return f"{commit}|{suite}|{server}|{variant}"


def cache_pass(suite, server, variant):
    v = cache.get(cache_key(suite, server, variant))
    if isinstance(v, dict):
        return v.get("result") == "PASS"
    return v == "PASS"


def cache_store(suite, server, variant, result, counts):
    k = cache_key(suite, server, variant)
    if result == "PASS":
        cache[k] = {"result": "PASS", **counts}
    else:
        cache.pop(k, None)


def cached_counts(suite, server, variant):
    v = cache.get(cache_key(suite, server, variant))
    if isinstance(v, dict):
        return {"pass": int(v.get("pass", 1)), "fail": int(v.get("fail", 0)),
                "skip": int(v.get("skip", 0)), "known": int(v.get("known", 0))}
    return {"pass": 1, "fail": 0, "skip": 0, "known": 0}


def known_limits():
    path = os.path.join(HERE, "known-limits.tsv")
    out = []
    if not os.path.exists(path):
        return out
    for line in open(path, encoding="utf-8", errors="replace"):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.rstrip("\n").split("\t")
        if not f or f[0] == "server":
            continue
        while len(f) < 5:
            f.append("")
        out.append(f[:5])
    return out


LIMITS = None


def limits():
    global LIMITS
    if LIMITS is None:
        LIMITS = known_limits()
    return LIMITS


def known_match(server, suite, check):
    for row in limits():
        if row[0] == server and row[1] == suite and row[2] == check:
            return row
    return None


def classify(server, suite, check, step_result, detail=""):
    row = known_match(server, suite, check)
    if step_result == "skip":
        return "SKIP"
    if step_result == "ok":
        return "unexpected pass" if row else "PASS"
    if row:
        return "KNOWN"
    return "FAIL"


def worst(statuses):
    best = "SKIP"
    for status in statuses:
        if RANK.get(status, 0) > RANK.get(best, 0):
            best = status
    return best


