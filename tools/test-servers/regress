    else:
        raise ValueError(f"no runner for suite {suite}")


RECREATE_DOVECOT = "tools/test-servers/start.sh --recreate dovecot-245"


def fake_smtp_port():
    """(port, "") from the single fake-smtp-sink row of generated/local-ports.tsv, else (0, why)."""
    import lab
    path = os.path.join(lab.GEN, "local-ports.tsv")
    try:
        rows = [l.rstrip("\n").split("\t") for l in open(path, encoding="utf-8")]
    except OSError as e:
        return 0, f"cannot read {path}: {e.strerror or e}"
    got = [r[1] for r in rows if len(r) == 4 and r[0] == "fake-smtp-sink"]
    if len(got) != 1 or not got[0].isdigit():
        return 0, f"{len(got)} fake-smtp-sink rows in {path} (want one); run {RECREATE_DOVECOT}"
    return int(got[0]), ""


def relay_check(cont):
    """The container's submission relay is the fake SMTP sink: docker gateway : fake-smtp-sink port, and it answers."""
    port, err = fake_smtp_port()
    if err:
        return err
    r = subprocess.run(["docker", "inspect", "-f", "{{range .NetworkSettings.Networks}}{{.Gateway}} {{end}}", cont],
                       capture_output=True, text=True, errors="replace")
    gw = (r.stdout or "").split()
    if r.returncode != 0 or len(gw) != 1:
        return f"cannot read the docker gateway of {cont}: {first_line(r.stderr or r.stdout or 'none')}"
    r = subprocess.run(["docker", "exec", cont, "doveconf", "-h", "submission_relay_host", "submission_relay_port"],
                       capture_output=True, text=True, errors="replace")
    got = (r.stdout or "").split()
    if r.returncode != 0 or got != [gw[0], str(port)]:
        return (f"submission relay is {' '.join(got) or first_line(r.stderr or 'unset')}, want {gw[0]} {port} "
                f"(recreate: {RECREATE_DOVECOT})")
    err = smtp_banner(gw[0], port)
    if err:
        return f"fake SMTP sink on {gw[0]}:{port}: {err}"
    return ""


def start_fake_smtp():
    """Start ai-fake-smtp.py on the fake-smtp-sink port for this run. A port in use is an error, not a reuse."""
    global fake_smtp
    port, err = fake_smtp_port()
    if err:
        return err
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # TIME_WAIT from a past run is not "in use"
    try:
        probe.bind(("", port))
    except OSError as e:
        return (f"fake-smtp-sink port {port} (generated/local-ports.tsv) is in use ({e.strerror or e}); "
                f"draw a new one: {RECREATE_DOVECOT}")
    finally:
        probe.close()
    os.makedirs(run_log, exist_ok=True)
    fake_smtp = subprocess.Popen([sys.executable, os.path.join(HERE, "ai-fake-smtp.py"), str(port)],
                                 env=child_env({"LAB_LOG": os.path.join(run_log, "fake-smtp.log")}),
                                 stdout=subprocess.DEVNULL, stderr=open(os.path.join(run_log, "fake-smtp.err"), "w"))
    for _ in range(50):
        if fake_smtp.poll() is not None:
            return f"ai-fake-smtp.py exited {fake_smtp.returncode} (see {run_log}/fake-smtp.err)"
        if not smtp_banner("127.0.0.1", port):
            return ""
        time.sleep(0.1)
    return f"ai-fake-smtp.py gave no banner on {port} in 5s"


def domain_login_reply(s, account):
    import lab
    caps = lab.plain_caps(s["imap"]).split()
    # Clear text unless login-policy.tsv says the server refuses it (or it advertises LOGINDISABLED).
    if "LOGINDISABLED" in caps or (lab.login_policy(s["name"])["cleartext"] == "no" and "STARTTLS" in caps):
        err = lab._starttls_login(s["imap"], account)
        return "OK" if not err else err
    return lab._plain_login_reply(s["imap"], account)


def domain_login_check(s):
