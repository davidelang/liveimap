    if cleaned:
        return
    cleaned = True
    if fake_smtp is not None and fake_smtp.poll() is None:
        fake_smtp.terminate()
        try:
            fake_smtp.wait(timeout=10)
        except subprocess.TimeoutExpired:
            fake_smtp.kill()
    # Force-stop only after a suite function has been entered. The lock is not that mark.
    if hold_lock and suites_started and not dry_run:
        try:
            subprocess.run(["adb", "-s", SERIAL, "shell", "am", "force-stop", PKG],
                           capture_output=True, text=True, errors="replace", timeout=20)
        except Exception:
            pass
    if hold_lock:
        try:
            os.remove(LOCK_PATH)
        except FileNotFoundError:
            pass
        except OSError:
            pass


def on_signal(signum, frame):
