def failing_names(items):
    out = []
    for row in items:
        if row.get("result") == "FAIL" and row.get("failing_check"):
            variant = row.get("variant") or ""
            out.append(" ".join(p for p in (row.get("server", ""), row.get("suite", ""), variant, row.get("failing_check", "")) if p))
    return out


def previous_results():
    """Newest older results.json that is not BLOCKED and has rows."""
    if not os.path.isdir(REC_ROOT):
        return None
    found = []
    for name in os.listdir(REC_ROOT):
        if name == run_id:
            continue
        path = os.path.join(REC_ROOT, name, "results.json")
        if not os.path.isfile(path):
            continue
        try:
            found.append((os.path.getmtime(path), path))
        except OSError:
            continue
    found.sort(reverse=True)
    for _, path in found:
        try:
            data = json.load(open(path, encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue
        if data.get("verdict") == "BLOCKED" or not data.get("rows"):
            continue
        return path
    return None


def check_ran(rows, key):
    """True when this run covered that server, suite, variant, and check."""
    server, suite, variant, check = key
    for row in rows or []:
        if not isinstance(row, dict):
            continue
        if (row.get("server") or "", row.get("suite") or "", row.get("variant") or "") != (server, suite, variant):
            continue
        named = row.get("failing_check") or ""
        # An unnamed row means that slot ran, so a check of the same slot was covered.
        if named == check or named == "":
            return True
    return False


def failing_map(items):
    found = {}
    for row in items or []:
        if not isinstance(row, dict) or row.get("result") != "FAIL":
            continue
        check = row.get("failing_check") or ""
        if not check:
            continue
        key = (row.get("server") or "", row.get("suite") or "", row.get("variant") or "", check)
        found[key] = " ".join(p for p in key if p)
    return found


def regressions(current_rows):
    prev_path = previous_results()
    if not prev_path:
        return "none"
    try:
        prev = json.load(open(prev_path, encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "none"
    if not isinstance(prev, dict):
        return "none"
    prev_rows = prev.get("rows") or []
    before = failing_map(prev_rows)
    after = failing_map(current_rows)
    plus, minus = [], []
    for key, label in after.items():
        if key not in before and check_ran(prev_rows, key):
            plus.append(label)
    for key, label in before.items():
        if key not in after and check_ran(current_rows, key):
            minus.append(label)
    if not plus and not minus:
        return "none"
    parts = [f"+ {n}" for n in sorted(plus)] + [f"- {n}" for n in sorted(minus)]
    return ", ".join(parts)


def write_outputs(verdict, blocked_reason, unseeded, suites, servers):
    fails = failing_names(rows)
    body_rows = []
    for row in rows:
        body_rows.append({k: redact(v) if isinstance(v, str) else v for k, v in row.items()})
    payload = {
        "run_id": run_id,
        "commit": commit,
        "verdict": verdict,
        "rows": body_rows,
        "failing_checks": [redact(n) for n in fails],
        "unseeded_servers": unseeded,
        "drift": drift_lines,
        "untested": [{"name": name, "reason": "no instrumented test"} for name in (UNTESTED if "ui" in suites else [])],
    }
    try:
        os.makedirs(run_rec, exist_ok=True)
    except OSError:
        print(redact(blocked_reason or verdict))
        return
    json.dump(payload, open(os.path.join(run_rec, "results.json"), "w", encoding="utf-8"), indent=2, sort_keys=True)
    lines = ["| server | suite | variant | pass | fail | skip | known | result | failing check | first error | seconds |",
             "|---|---|---|---|---|---|---|---|---|---|---|"]
    for row in body_rows:
        lines.append("| " + " | ".join(str(row[k]) for k in (
            "server", "suite", "variant", "pass", "fail", "skip", "known", "result", "failing_check", "first_error", "duration_s")) + " |")
    if payload["untested"]:
        lines.append("")
        lines.append("## untested")
        for item in payload["untested"]:
            lines.append(f"- {item['name']}: {item['reason']}")
    if unseeded:
        lines.append("")
        lines.append("## unseeded")
        for name in unseeded:
            lines.append(f"- {name}")
    if drift_lines:
        lines.append("")
        lines.append("## drift")
        for note in drift_lines:
            lines.append(f"- {note}")
    open(os.path.join(run_rec, "summary.md"), "w", encoding="utf-8").write("\n".join(lines) + "\n")
    findings = ", ".join(payload["failing_checks"]) if payload["failing_checks"] else "none"
    if verdict == "BLOCKED":
        findings = redact(blocked_reason)
    reg = "none" if verdict == "BLOCKED" else regressions(body_rows)
    matrix = "suites: " + ",".join(suites) + " servers: " + ",".join(servers)
    logs = os.path.join("sandbox", "test-servers", "logs", run_id)
    reason = redact(blocked_reason) if blocked_reason else "none"
    body = "\n".join([
        "STATUS: RESULTS",
        f"RESPONDING-TO: {responding_to}",
        f"COMMIT: {commit}",
        f"VERDICT: {verdict}",
        f"FINDINGS: {findings}",
        f"REGRESSIONS: {reg}",
        f"MATRIX: {matrix}",
        f"LOGS: {logs}",
        f"BLOCKED-REASON: {reason}",
        "",
    ])
    open(os.path.join(run_rec, "results-body.txt"), "w", encoding="utf-8").write(body)


def stop(msg, suites, servers, unseeded):
    line = redact(msg).replace("\n", " ").strip()
    if dry_run or not run_rec:
        print(line)
        sys.exit(1)
    write_outputs("BLOCKED", line, unseeded, suites, servers)
    print(line)
    sys.exit(1)


def main():
    global dry_run, secrets, run_id, run_rec, run_log, commit, cache, hold_lock, responding_to, any_skip
    p = argparse.ArgumentParser(description="Run the lab suites, IDLE events, and per-mechanism login.")
    p.add_argument("--commit", required=True)
    p.add_argument("--servers", default="all")
    p.add_argument("--suites", default="all")
    p.add_argument("--variants", default="")
    p.add_argument("--responding-to", default="")
    p.add_argument("--force", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    a = p.parse_args()
    dry_run = a.dry_run
    responding_to = a.responding_to or "none"
    commit = a.commit
    sha8 = commit[:8]
    run_id = time.strftime("%Y%m%d-%H%M%S") + "-" + sha8
    run_rec = os.path.join(REC_ROOT, run_id)
    run_log = os.path.join(LOG_ROOT, run_id)
    bind = source_address()
    if not bind:
        print("VERDICT BLOCKED no source address")
        sys.exit(1)
    os.environ["LAB_BIND"] = bind
    os.environ["LAB_HOST"] = bind
    os.environ["LAB_REC"] = run_rec
    os.environ["LAB_LOG"] = run_log
    sys.path.insert(0, HERE)
    try:
        import lab
    except SystemExit as e:
        print(redact(f"VERDICT BLOCKED {e}"))
        sys.exit(1)
    secrets = load_secrets()
    by_name = lab_servers_by_name()
    names, bad_server = selected_servers(a.servers, by_name)
    if bad_server:
        print(f"VERDICT BLOCKED unknown server {bad_server}")
        sys.exit(1)
    suites, bad_suite = selected_suites(a.suites)
    if bad_suite:
        print(f"VERDICT BLOCKED unknown suite {bad_suite}")
        sys.exit(1)
    if not dry_run:
        try:
            acquire_lock()
        except SystemExit:
            raise
        except OSError as e:
            print(redact(f"VERDICT BLOCKED lock: {e.strerror or e}"))
            sys.exit(1)
    reason = commit_stop(commit)
    if reason:
        stop(reason, suites, names, [])
    if dry_run:
        reason = dry_run_problems()
        if reason:
            stop(reason, suites, names, [])
        print("servers: " + " ".join(names))
        print("suites: " + " ".join(suites))
        return
    write_lock("preflight")
    if lab.emulator_in_use():
        stop("VERDICT BLOCKED emulator in use: " + lab.emulator_line, suites, names, [])
    mb = mem_available_mb()
    if mb < 2048:
        stop(f"VERDICT BLOCKED MemAvailable {mb} MB is below 2048 MB", suites, names, [])
    err = ensure_dirs()
    if not err:
        bad = lab_mount_errors()
        if bad:
            err = "VERDICT BLOCKED lab container mounts: " + " | ".join(bad)
    if err:
        stop(err, suites, names, [])
    used = servers_used(names, suites)
    unseeded = []
    if any(n in RELAY_SERVERS for n in used):
        err = start_fake_smtp()
        if err:
            stop(f"VERDICT BLOCKED {err}", suites, names, [])
    write_lock("seed")
    pending = list(used)
    for name in used:
        pending.pop(0)
        s = by_name.get(name)
        try:
            if s and s.get("container"):
                err = start_lab_container(s)
                if err:
                    stop(f"VERDICT BLOCKED {name}: {err}", suites, names, [])
                err = lab.check_published(s["container"])
                if err:
                    stop(f"VERDICT BLOCKED {name}: {err}", suites, names, [])
            err = probe_servers([name], by_name)
            if err:
                stop(f"VERDICT BLOCKED {err}", suites, names, [])
            problem = domain_login_check(s)
            if problem:
                stop(f"VERDICT BLOCKED {name} {problem} tools/test-servers/build-seed-image {name}", suites, names, [])
            imap_port = s.get("imap") if isinstance(s, dict) else None
            problem = lab.entry_version_problem(name, imap_port)
            if problem:
                stop(f"VERDICT BLOCKED {problem}", suites, names, [])
            if "imap" in suites:
                problem = lab.fixture_check(s)
                if problem:
                    stop(f"VERDICT BLOCKED {name} {problem} tools/test-servers/build-seed-image {name}", suites, names, [])
            blocked, drifted = verify_one(s, False)
            if blocked:
                stop(f"VERDICT BLOCKED {blocked} tools/test-servers/build-seed-image {name}", suites, names, [])
            drift_lines.extend(drifted)
        finally:
            if s and s.get("container"):
                stop_lab_container(s)
    cache.update(load_cache())
    if "imap" in suites:
        run_imap(names, a.variants, a.force)
    if "imap-idle" in suites:
        idle_steps, alt_host = imap_idle_steps()
        # lab.py forwards LAB_ALT_HOST as -e labAltHost. Pass it only when host.env sets the key.
        idle_env = {"LAB_ALT_HOST": alt_host} if alt_host else None
        run_lab_suite("imap-idle", names, ",".join(idle_steps), idle_steps, a.force, extra_env=idle_env)
    if "imap-mechs" in suites:
        run_lab_suite("imap-mechs", names, "open", ["open"], a.force, mech=True)
    if "jmap" in suites:
        run_jmap(names, a.force)
    if "smtp" in suites:
        run_smtp(a.force)
    if "sieve" in suites:
        run_lab_suite("sieve", sieve_names(names), "sieveDeliver", ["sieveDeliver"], a.force)
    if "contacts" in suites:
        if "dovecot-245" in names:
            run_lab_suite("contacts", ["dovecot-245"], "alpineBook", ["alpineBook"], a.force)
    if not any_skip:
        save_cache()
    verdict = "FAIL" if any(row["result"] == "FAIL" for row in rows) else "PASS"
    write_lock("cleanup")
    write_outputs(verdict, "", [], suites, names)
    print(f"VERDICT {verdict}")
    print(os.path.join("sandbox", "test-servers", "recordings", run_id, "summary.md"))


