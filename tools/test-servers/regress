def cache_key(suite, server, variant):
    return f"{commit}|{suite}|{server}|{variant}"


def cache_pass(suite, server, variant):
    v = cache.get(cache_key(suite, server, variant))
    if isinstance(v, dict):
        return v.get("result") == "PASS"
    return v == "PASS"


def cache_store(suite, server, variant, result, counts):
    k = cache_key(suite, server, variant)
    if result == "PASS":
        cache[k] = {"result": "PASS", **counts}
    else:
        cache.pop(k, None)


def cached_counts(suite, server, variant):
    v = cache.get(cache_key(suite, server, variant))
    if isinstance(v, dict):
        return {"pass": int(v.get("pass", 1)), "fail": int(v.get("fail", 0)),
                "skip": int(v.get("skip", 0)), "known": int(v.get("known", 0))}
    return {"pass": 1, "fail": 0, "skip": 0, "known": 0}


def known_limits():
    path = os.path.join(HERE, "known-limits.tsv")
    out = []
    if not os.path.exists(path):
        return out
    for line in open(path, encoding="utf-8", errors="replace"):
        if not line.strip() or line.startswith("#"):
            continue
        f = line.rstrip("\n").split("\t")
        if not f or f[0] == "server":
            continue
        while len(f) < 5:
            f.append("")
        out.append(f[:5])
    return out


LIMITS = None


def limits():
    global LIMITS
    if LIMITS is None:
        LIMITS = known_limits()
    return LIMITS


def known_match(server, suite, check):
    for row in limits():
        if row[0] == server and row[1] == suite and row[2] == check:
            return row
    return None


def classify(server, suite, check, step_result, detail=""):
    row = known_match(server, suite, check)
    if step_result == "skip":
        return "SKIP"
    if step_result == "ok":
        return "unexpected pass" if row else "PASS"
    if row:
        return "KNOWN"
    return "FAIL"


def worst(statuses):
    best = "SKIP"
    for status in statuses:
        if RANK.get(status, 0) > RANK.get(best, 0):
            best = status
    return best


def plan_units(suites, names, sieve=None):
    """[(server, suite)] in the order main() runs them; mirrors each runner's own server filter."""
    sieve = sieve_names(names) if sieve is None else sieve
    units = []
    for suite in suites:
        if suite in ("imap", "imap-idle", "imap-mechs"):
            units += [(n, suite) for n in names]
        elif suite == "jmap":
            units += [(n, suite) for n in JMAP_SERVERS if n in names]
        elif suite == "smtp":
            units.append(("dovecot-dev", suite))
        elif suite == "sieve":
            units += [(n, suite) for n in sieve]
        elif suite == "contacts" and "dovecot-245" in names:
            units.append(("dovecot-245", suite))
    return units


def fmt_secs(sec):
    sec = int(sec)
    return f"{sec // 60}m{sec % 60:02d}s" if sec >= 60 else f"{sec}s"


def progress(line):
    print("[regress] " + line, file=sys.stderr, flush=True)


def rows_done():
    return sum(unit_rows.values())


def rows_planned():
    """Result lines for the whole run: a finished unit counts what it reported, an open one what it is expected
    to report (the previous run's count), so m only moves when a unit reports more or fewer variants."""
    total = 0
    for u in plan:
        got = unit_rows.get(u, 0)
        total += got if u in done_units else max(got, expected_rows.get(u, 1))
    return total + sum(n for u, n in unit_rows.items() if u not in plan)


def progress_row(server, suite, variant, result, duration):
    unit = (server, suite)
    unit_rows[unit] = unit_rows.get(unit, 0) + 1
    if quiet and result not in ("FAIL", "BLOCKED"):
        return
    progress(f"{rows_done()}/{rows_planned()} {server} {suite} {variant or '-'} {result} {fmt_secs(duration)}"
             f" (total {fmt_secs(time.time() - run_t0)})")


def heartbeat(label, stop_event, every=None):
    """Thread body: one 'still running' line per interval, naming the current server and suite, until stop_event."""
    every = HEARTBEAT_S if every is None else every
    t0 = time.time()
    while not stop_event.wait(every):
        where = " ".join(p for p in current_unit if p)
        progress(f"... still running {where + ': ' if where else ''}{label} {fmt_secs(time.time() - t0)}"
                 f" ({rows_done()}/{rows_planned()} results, {len([u for u in plan if u in done_units])}/{len(plan)}"
                 f" server x suite units done)")


setup_done = [0]
setup_total = [0]


def server_major(units, used):
    """[(server, [suites])]: units grouped per server, servers in servers_used order (then any plan-only server,
    e.g. smtp's dovecot-dev), suites in plan order. main() runs one server at a time in this order."""
    order = list(used) + [n for n, _ in units if n not in used]
    out = []
    for name in order:
        mine = [suite for n, suite in units if n == name]
        if mine and name not in [n for n, _ in out]:
            out.append((name, mine))
    return out


def previous_row_counts():
    """(server, suite) -> result lines in the previous run; {} when there is none. Progress estimate only."""
    path = previous_results()
    if not path:
        return {}
    try:
        prev = json.load(open(path, encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        progress(f"progress estimate: cannot read {path}: {e}; m counts one line per unit until each finishes")
        return {}
    counts = {}
    for row in (prev.get("rows") or []) if isinstance(prev, dict) else []:
        key = (row.get("server") or "", row.get("suite") or "")
        counts[key] = counts.get(key, 0) + 1
    return counts


def setup_steps(used, by_name, suites):
    """[(server, step)] for one server's setup (main() passes [name] and that server's suites), in run order."""
    steps = []
    for name in used:
        s = by_name.get(name)
        if s and s.get("container"):
            steps += [(name, "start"), (name, "check_published")]
        steps += [(name, "probe"), (name, "login"), (name, "entry-version")]
        if "imap" in suites:
            steps.append((name, "fixture"))
        steps.append((name, "verify-seed"))
    return steps


def timed_step(label, fn, failed=lambda r: bool(r), counter=None):
    """Run fn() with a heartbeat; report 'setup k/K label ok|FAIL dur (total T)' when it ends. --quiet keeps only
    FAIL lines. counter=None counts against the setup plan; a string is printed in its place (suite resets)."""
    import threading
    stop_event = threading.Event()
    hb = None
    if not quiet:
        hb = threading.Thread(target=heartbeat, args=(label, stop_event), daemon=True)
        hb.start()
    t0 = time.time()
    result = None
    try:
        result = fn()
    finally:
        stop_event.set()
        if hb is not None:
            hb.join()
    bad = failed(result)
    if counter is None:
        setup_done[0] += 1
        counter = f"setup {setup_done[0]}/{setup_total[0]}"
    if bad or not quiet:
        detail = ""
        if bad and isinstance(result, str):
            detail = " " + redact(result)[:200]
        progress(f"{counter} {label} {'FAIL' if bad else 'ok'} {fmt_secs(time.time() - t0)}"
                 f" (total {fmt_secs(time.time() - run_t0)}){detail}")
    return result


def add_row(server, suite, variant, counts, result, failing, error, duration):
    if result == "FAIL" and not str(error or "").strip():
        # A FAIL must say why. An empty detail is a harness defect; name where it came from.
        error = f"no detail reported for {failing or suite} (harness: empty failure text)"
    if result == "SKIP" and not str(error or "").strip():
        # A SKIP must say why too (contacts alpineBook came out as an empty SKIP, 2026-10-22).
        error = f"no skip reason reported for {variant or suite} (harness: empty skip text)"
    progress_row(server, suite, variant, result, duration)
    rows.append({
        "server": server,
        "suite": suite,
        "variant": variant,
        "pass": counts.get("pass", 0),
        "fail": counts.get("fail", 0),
        "skip": counts.get("skip", 0),
        "known": counts.get("known", 0),
        "result": result,
        "failing_check": failing,
        "first_error": redact(error)[:300],
        "duration_s": int(duration),
    })


def counts_for(status):
    c = {"pass": 0, "fail": 0, "skip": 0, "known": 0}
    if status == "PASS":
        c["pass"] = 1
    elif status == "FAIL":
        c["fail"] = 1
    elif status == "SKIP":
        c["skip"] = 1
    elif status == "KNOWN":
        c["known"] = 1
    return c


def tsv_map(path):
    out = {}
    if not path or not os.path.isfile(path):
        return out
    lines = open(path, encoding="utf-8", errors="replace").read().splitlines()
    for line in lines[1:]:
        f = line.split("\t")
        if len(f) >= 2 and f[0] and f[0] != "step":
            out[f[0]] = (f[1], f[2] if len(f) > 2 else "")
    return out


def parse_lab_summary(text):
    path = ""
    for line in reversed((text or "").splitlines()):
        line = line.strip()
        if line.endswith("-summary.tsv") or line.endswith("summary.tsv"):
            path = line
            break
    parsed = []
    if path and os.path.isfile(path):
        for line in open(path, encoding="utf-8", errors="replace"):
            f = line.rstrip("\n").split("\t")
            if len(f) < 7 or f[0] == "server":
                continue
            parsed.append({
                "server": f[0], "protocol": f[1], "tls": f[2], "result": f[3],
                "detail": f[4], "seconds": int(f[5]) if f[5].isdigit() else 0, "dest": f[6],
            })
    return parsed


def steps_for(row):
    proto, mech = row["protocol"], ""
    if "/" in proto:
        mech = proto.split("/", 1)[1]
    run = f"{row['server']}-{row['tls']}" + (f"-{mech}" if mech else "")
    path = os.path.join(row["dest"], f"{run}.steps.tsv")
    got = tsv_map(path)
    if got:
        return got
    bad = re.search(r"bad=([^\s]+)", row["detail"] or "")
    if not bad:
        return {}
    return {name: ("fail", row["detail"]) for name in bad.group(1).split(",") if name}


def step_status(steps, check, summary_result):
    """A step the suite never ran (no IDLE, no sieve port) is a skip. A failed open is a fail."""
    if summary_result == "expected" and check == "open" and check in steps and steps[check][0] != "ok":
        # lab.py marks a policy refusal of plaintext login "expected": the server is right, the variant is skipped.
        return "skip", "server policy: " + steps[check][1]
    if check in steps:
        res = steps[check][0]
        if res == "ok":
            return "ok", steps[check][1]
        if res == "skip":
            # LabSuiteTest skipStep: the step cannot run on this server and says why.
            return "skip", steps[check][1]
        return "fail", steps[check][1]
    if summary_result in ("skip", "assumption", "pass", "expected"):
        return "skip", f"step {check} not run (absent from steps.tsv)"
    if "open" in steps and steps["open"][0] != "ok":
        return "fail", steps["open"][1]
    if summary_result == "fail":
        # The variant ran other steps but not this one (tlsUntrusted on a plaintext variant): not run, not a fail.
        if steps:
            return "skip", f"step {check} not run (absent from steps.tsv)"
        return "fail", "lab run failed before any step ran"
    return "skip", f"step {check} not run (absent from steps.tsv)"


