def reset_lab_server(s):
    """Replace the container from its published seed image. Empty on success."""
    import lab
    cont = s["container"]
    hint = lab.RECREATE_HINTS.get(cont)
    if not hint:
        return f"{cont}: no reset script"
    rel = hint.split()[0]
    script = os.path.join(REPO, rel)
    r = subprocess.run([script, "--reset", s["name"]], capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        text = (r.stderr or "") + "\n" + (r.stdout or "")
        return snapshot_line(text) or first_line(text)
    return ""


def reset_for_suite(suite, name):
    """Drop the copy-on-write container and recreate it from its seed image, so a suite never sees an
    earlier suite's writes (the imap suite's appends). Empty on success; servers without a container pass."""
    import lab
    s = lab_servers_by_name().get(name)
    if not s or not s.get("container"):
        return ""
    if name in fresh:
        # setup_server created it from its seed moments ago and no suite has written to it: nothing to undo.
        fresh.discard(name)
        return ""
    lab.only_one("")
    n = len([u for u in plan if u in done_units])
    err = timed_step(f"{name} reset for {suite}", lambda: reset_lab_server(s), counter=f"reset ({n}/{len(plan)} done)")
    return f"reset before {suite}: {err}" if err else ""


def reset_or_fail(suite, name, check):
    """Reset [name] for [suite]; on failure record a FAIL row and return False (the suite is not run)."""
    err = reset_for_suite(suite, name)
    if not err:
        return True
    add_row(name, suite, "", counts_for("FAIL"), "FAIL", check, redact(err), 0)
    cache_store(suite, name, "", "FAIL", counts_for("FAIL"))
    return False


def container_running(cont):
    r = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", cont],
                       capture_output=True, text=True, errors="replace")
    return r.returncode == 0 and (r.stdout or "").strip() == "true"


def container_logs(cont):
    logs = subprocess.run(["docker", "logs", cont], capture_output=True, text=True, errors="replace")
    return (logs.stdout or "") + "\n" + (logs.stderr or "")


def start_lab_container(s, skip=False):
    """Stop every other liveimap-* container, start this one, and run its up command."""
    import lab
    cont = s["container"]
    lab.only_one(cont)
    if not skip:
        err = reset_lab_server(s)
        if err:
            return err
    if container_running(cont):
        r = subprocess.run(["docker", "stop", "-t", "20", cont], capture_output=True, text=True, errors="replace")
        if r.returncode != 0 or container_running(cont):
            return first_line(r.stderr or r.stdout)
    r = subprocess.run(["docker", "start", cont], capture_output=True, text=True, errors="replace")
    if r.returncode != 0:
        return snapshot_line(r.stderr or r.stdout) or first_line(r.stderr or r.stdout)
    if not container_running(cont):
        text = container_logs(cont)
        return snapshot_line(text) or first_line(text)
    upcmd = lab.up_commands().get(cont)
    if upcmd:
        r = subprocess.run(["docker", "exec", cont, "sh", "-c", upcmd], capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            text = (r.stderr or "") + "\n" + (r.stdout or "")
            return snapshot_line(text) or first_line(text)
        if not container_running(cont):
            text = container_logs(cont)
            return snapshot_line(text) or first_line(text)
    n = 900 if cont in lab.ALONE else 300
    deadline = time.time() + n
    while time.time() < deadline:
        if not container_running(cont):
            text = container_logs(cont)
            return snapshot_line(text) or first_line(text)
        if lab.greeting(s["imap"], False, timeout=1):
            break
    else:
        if not container_running(cont):
            text = container_logs(cont)
            return snapshot_line(text) or first_line(text)
        return f"no IMAP greeting after {n}s"
    time.sleep(5)
    return ""


def stop_lab_container(s):
