def package_commit(pkg, aapt):
    """(commit, "") from the installed APK's liveimap.gitCommit, or (None, why)."""
    if not aapt:
        return None, "no aapt under the Android SDK build-tools"
    if not run_log:
        return None, "no run log dir"
    remote = device_apk_path(pkg)
    if not remote:
        return None, f"{pkg} is not installed on {SERIAL}"
    local = os.path.join(run_log, pkg + ".apk")
    if not copy_device_apk(remote, local):
        return None, f"cannot copy {pkg} {remote} from {SERIAL}"
    try:
        r = subprocess.run([aapt, "dump", "xmltree", local, "AndroidManifest.xml"],
                           capture_output=True, text=True, errors="replace", timeout=60)
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, f"aapt failed on {pkg}: {e}"
    if r.returncode != 0:
        return None, f"aapt exit {r.returncode} on {pkg}"
    val = git_commit_from_xmltree(r.stdout)
    if not val:
        return None, f"{pkg} manifest has no liveimap.gitCommit meta-data"
    return val, ""


def commit_stop(expect):
    aapt = newest_aapt()
    full = expect
    try:
        r = subprocess.run(["git", "-C", REPO, "rev-parse", "--verify", expect + "^{commit}"],
                           capture_output=True, text=True, timeout=20)
        if r.returncode == 0:
            full = r.stdout.strip()
    except (subprocess.TimeoutExpired, OSError):
        pass
    problems = []
    for pkg in (PKG, TEST_PKG):
        val, why = package_commit(pkg, aapt)
        if not val:
            problems.append(f"{why}; run: {INSTALL_HINT[pkg]} (built at {expect})")
        elif not (val == full or val.startswith(expect) or full.startswith(val)):
            problems.append(f"{pkg} liveimap.gitCommit={val[:12]} != {expect}; run: {INSTALL_HINT[pkg]} (built at {expect})")
    if problems:
        return "VERDICT BLOCKED " + " | ".join(problems)
    return ""


