def run_cmd(args, log_name, env, timeout=None):
    import threading
    stop_event = threading.Event()
    beat = None
    if not quiet:
        beat = threading.Thread(target=heartbeat, args=(log_name[:-4] if log_name.endswith(".log") else log_name, stop_event),
                                daemon=True)
        beat.start()
    try:
        return _run_cmd(args, log_name, env, timeout)
    finally:
        stop_event.set()
        if beat:
            beat.join()


def _run_cmd(args, log_name, env, timeout=None):
    try:
        r = subprocess.run(args, capture_output=True, text=True, errors="replace", env=env, cwd=REPO, timeout=timeout)
    except subprocess.TimeoutExpired as e:
        text = (e.stdout or "") + "\n" + (e.stderr or "") + "\ntimeout"
        write_log(log_name, text)
        return 124, text
    except OSError as e:
        text = str(e)
        write_log(log_name, text)
        return 127, text
    text = (r.stdout or "") + (("\n" + r.stderr) if r.stderr else "")
    write_log(log_name, text)
    return r.returncode, text


