    found.sort(reverse=True)
    for _, path in found:
        try:
            data = json.load(open(path, encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue
        if data.get("verdict") == "BLOCKED" or not data.get("rows"):
            continue
        return path
    return None


def check_ran(rows, key):
    """True when this run covered that server, suite, variant, and check."""
    server, suite, variant, check = key
    for row in rows or []:
        if not isinstance(row, dict):
            continue
        if (row.get("server") or "", row.get("suite") or "", row.get("variant") or "") != (server, suite, variant):
            continue
        named = row.get("failing_check") or ""
        # An unnamed row means that slot ran, so a check of the same slot was covered.
        if named == check or named == "":
            return True
    return False


def failing_map(items):
    found = {}
    for row in items or []:
        if not isinstance(row, dict) or row.get("result") != "FAIL":
            continue
        check = row.get("failing_check") or ""
        if not check:
            continue
        key = (row.get("server") or "", row.get("suite") or "", row.get("variant") or "", check)
        found[key] = " ".join(p for p in key if p)
    return found


def regressions(current_rows):
    prev_path = previous_results()
    if not prev_path:
        return "none"
    try:
        prev = json.load(open(prev_path, encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "none"
    if not isinstance(prev, dict):
        return "none"
    prev_rows = prev.get("rows") or []
    before = failing_map(prev_rows)
    after = failing_map(current_rows)
    plus, minus = [], []
    for key, label in after.items():
        if key not in before and check_ran(prev_rows, key):
            plus.append(label)
    for key, label in before.items():
        if key not in after and check_ran(current_rows, key):
            minus.append(label)
    if not plus and not minus:
        return "none"
    parts = [f"+ {n}" for n in sorted(plus)] + [f"- {n}" for n in sorted(minus)]
    return ", ".join(parts)


def write_outputs(verdict, blocked_reason, unseeded, suites, servers):
    fails = failing_names(rows)
    body_rows = []
    for row in rows:
        body_rows.append({k: redact(v) if isinstance(v, str) else v for k, v in row.items()})
    payload = {
        "run_id": run_id,
        "commit": commit,
        "verdict": verdict,
        "rows": body_rows,
        "failing_checks": [redact(n) for n in fails],
        "unseeded_servers": unseeded,
        "drift": drift_lines,
        "untested": [{"name": name, "reason": "no instrumented test"} for name in (UNTESTED if "ui" in suites else [])],
    }
    try:
        os.makedirs(run_rec, exist_ok=True)
    except OSError:
        print(redact(blocked_reason or verdict))
        return
    json.dump(payload, open(os.path.join(run_rec, "results.json"), "w", encoding="utf-8"), indent=2, sort_keys=True)
    lines = ["| server | suite | variant | pass | fail | skip | known | result | failing check | first error | seconds |",
             "|---|---|---|---|---|---|---|---|---|---|---|"]
    if blocked_reason and not body_rows:
        lines = ["**BLOCKED before setup:** no server was started and no suite ran.", "", redact(blocked_reason)]
    for row in body_rows:
        lines.append("| " + " | ".join(str(row[k]) for k in (
            "server", "suite", "variant", "pass", "fail", "skip", "known", "result", "failing_check", "first_error", "duration_s")) + " |")
    if payload["untested"]:
        lines.append("")
        lines.append("## untested")
        for item in payload["untested"]:
            lines.append(f"- {item['name']}: {item['reason']}")
    if unseeded:
        lines.append("")
        lines.append("## unseeded")
        for name in unseeded:
            lines.append(f"- {name}")
    if drift_lines:
        lines.append("")
        lines.append("## drift")
        for note in drift_lines:
            lines.append(f"- {note}")
    open(os.path.join(run_rec, "summary.md"), "w", encoding="utf-8").write("\n".join(lines) + "\n")
    findings = ", ".join(payload["failing_checks"]) if payload["failing_checks"] else "none"
    if verdict == "BLOCKED":
        findings = redact(blocked_reason)
    reg = "none" if verdict == "BLOCKED" else regressions(body_rows)
    matrix = "suites: " + ",".join(suites) + " servers: " + ",".join(servers)
    logs = os.path.join("sandbox", "test-servers", "logs", run_id)
    reason = redact(blocked_reason) if blocked_reason else "none"
    body = "\n".join([
        "STATUS: RESULTS",
        f"RESPONDING-TO: {responding_to}",
        f"COMMIT: {commit}",
        f"VERDICT: {verdict}",
        f"FINDINGS: {findings}",
        f"REGRESSIONS: {reg}",
        f"MATRIX: {matrix}",
        f"LOGS: {logs}",
        f"BLOCKED-REASON: {reason}",
        "",
    ])
    open(os.path.join(run_rec, "results-body.txt"), "w", encoding="utf-8").write(body)


SUMMARY_ORDER = ("PASS", "FAIL", "SKIP", "KNOWN", "unexpected pass", "BLOCKED")
SUMMARY_RANK = {"BLOCKED": 6, "FAIL": 5, "unexpected pass": 4, "KNOWN": 3, "PASS": 2, "SKIP": 1}


def final_summary(verdict_line, now=None):
    """The end-of-run summary (stdout, also under --quiet): totals by result line and by server x suite unit,
    one line per server, every non-PASS row, elapsed time, the summary.md path, and the VERDICT line last.
    Error text is redacted like summary.md."""
    def tally(results):
        c = {k: 0 for k in SUMMARY_ORDER}
        for r in results:
            c[r if r in c else "FAIL"] += 1
        return " ".join(f"{k.lower()} {c[k]}" for k in SUMMARY_ORDER)

    units, servers = {}, {}
    for row in rows:
        key = (row["server"], row["suite"])
        prev = units.get(key)
        if prev is None or SUMMARY_RANK.get(row["result"], 5) > SUMMARY_RANK.get(prev, 5):
            units[key] = row["result"]
        servers.setdefault(row["server"], []).append(row["result"])
    checks = {k: sum(int(row.get(k, 0) or 0) for row in rows) for k in ("pass", "fail", "skip", "known")}
    before_setup = not rows and verdict_line.startswith("VERDICT BLOCKED")
    if before_setup:
        lines = ["== regress summary ==", "blocked before setup: no server was started and no suite ran"]
    else:
        lines = ["== regress summary ==",
                 f"results ({len(rows)}): {tally(r['result'] for r in rows)}",
                 f"units ({len(units)}): {tally(units.values())}",
                 "checks: " + " ".join(f"{k} {v}" for k, v in checks.items())]
    for name, results in servers.items():
        lines.append(f"  {redact(name)}: {tally(results)}")
    odd = [row for row in rows if row["result"] != "PASS"]
    if not before_setup:
        lines.append(f"non-pass rows ({len(odd)}):" if odd else "non-pass rows: none")
    for row in odd:
        lines.append("  " + " ".join(redact(str(v)) or "-" for v in (
            row["server"], row["suite"], row["variant"] or "-", row["result"], row["failing_check"] or "-"))
            + " " + (redact(row["first_error"])[:160] or "-"))
    elapsed = (now if now is not None else time.time()) - run_t0 if run_t0 else 0
    lines.append(f"elapsed: {fmt_secs(elapsed)}")
    md = os.path.join(run_rec, "summary.md") if run_rec else ""
    if md and os.path.exists(md):
        lines.append("summary: " + os.path.join("sandbox", "test-servers", "recordings", run_id, "summary.md"))
    else:
        lines.append("summary: not written")
    lines.append(redact(verdict_line))
    return "\n".join(lines)


def finish(verdict_line, code=1):
    print(final_summary(verdict_line), flush=True)
    sys.exit(code)


def stop(msg, suites, servers, unseeded):
    line = redact(msg).replace("\n", " ").strip()
    if dry_run:
        print(line)
        sys.exit(1)
    if run_rec:
        write_outputs("BLOCKED", line, unseeded, suites, servers)
    finish(line)


def main():
    global quiet, plan, run_t0
    global dry_run, secrets, run_id, run_rec, run_log, commit, cache, hold_lock, responding_to, any_skip
    p = argparse.ArgumentParser(description="Run the lab suites, IDLE events, and per-mechanism login.")
    p.add_argument("--commit", required=True)
    p.add_argument("--servers", default="all")
    p.add_argument("--suites", default="all")
    p.add_argument("--variants", default="")
    p.add_argument("--responding-to", default="")
    p.add_argument("--force", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--quiet", action="store_true", help="no progress on stderr; only FAIL lines and the final VERDICT")
    a = p.parse_args()
    dry_run = a.dry_run
    quiet = a.quiet
    run_t0 = time.time()
    responding_to = a.responding_to or "none"
    commit = a.commit
    sha8 = commit[:8]
    run_id = time.strftime("%Y%m%d-%H%M%S") + "-" + sha8
    run_rec = os.path.join(REC_ROOT, run_id)
    run_log = os.path.join(LOG_ROOT, run_id)
    bind = source_address()
    if not bind:
        finish("VERDICT BLOCKED no source address")
    os.environ["LAB_BIND"] = bind
    os.environ["LAB_HOST"] = bind
    os.environ["LAB_REC"] = run_rec
    os.environ["LAB_LOG"] = run_log
    sys.path.insert(0, HERE)
    try:
        import lab
    except SystemExit as e:
        finish(f"VERDICT BLOCKED {e}")
    secrets = load_secrets()
    by_name = lab_servers_by_name()
    names, bad_server = selected_servers(a.servers, by_name)
    if bad_server:
        finish(f"VERDICT BLOCKED unknown server {bad_server}")
    suites, bad_suite = selected_suites(a.suites)
    if bad_suite:
        finish(f"VERDICT BLOCKED unknown suite {bad_suite}")
    plan = plan_units(suites, names)
    used = servers_used(names, suites)
    per_server = server_major(plan, used)
    plan = [(name, suite) for name, mine in per_server for suite in mine]
    idle_steps, alt_host = imap_idle_steps() if "imap-idle" in suites else ([], "")
    # lab.py forwards LAB_ALT_HOST as -e labAltHost. Pass it only when host.env sets the key.
    idle_env = {"LAB_ALT_HOST": alt_host} if alt_host else None
    expected_rows.update(previous_row_counts())
    for unit in plan:
        if unit[1] == "imap-idle":
            expected_rows[unit] = len(idle_steps)
    if not quiet and not dry_run:
        progress(f"start: {len(per_server)} servers, {len(plan)} server x suite units ({', '.join(suites)}),"
                 f" ~{rows_planned()} result lines; one server at a time: setup, its suites (reset between), teardown;"
                 f" heartbeat every {fmt_secs(HEARTBEAT_S)}")
    if dry_run:
        for i, (name, mine) in enumerate(per_server, 1):
            s = by_name.get(name)
            steps = ", ".join(step for _n, step in setup_steps([name], by_name, mine))
            seq = "; ".join(suite if j == 0 else f"reset, {suite}" for j, suite in enumerate(mine))
            down = "stop, rm" if s and s.get("container") else "-"
            print(f"plan {i}/{len(per_server)} {name}: setup ({steps}); {seq}; teardown ({down})")
    if not dry_run:
        try:
            acquire_lock()
        except SystemExit:
            raise
        except OSError as e:
            finish(f"VERDICT BLOCKED lock: {e.strerror or e}")
    reason = commit_stop(commit)
    if reason:
        stop(reason, suites, names, [])
    if dry_run:
        reason = dry_run_problems()
        if reason:
            stop(reason, suites, names, [])
        print("servers: " + " ".join(names))
        print("suites: " + " ".join(suites))
        return
    write_lock("preflight")
    if lab.emulator_in_use():
        stop("VERDICT BLOCKED emulator in use: " + lab.emulator_line, suites, names, [])
    mb = mem_available_mb()
    if mb < 2048:
        stop(f"VERDICT BLOCKED MemAvailable {mb} MB is below 2048 MB", suites, names, [])
    err = ensure_dirs()
    if not err:
        bad = lab_mount_errors()
        if bad:
            err = "VERDICT BLOCKED lab container mounts: " + " | ".join(bad)
    if err:
        stop(err, suites, names, [])
    if any(n in RELAY_SERVERS for n, _mine in per_server):
        err = start_fake_smtp()
        if err:
            stop(f"VERDICT BLOCKED {err}", suites, names, [])
    cache.update(load_cache())
    for i, (name, mine) in enumerate(per_server, 1):
        s = by_name.get(name)
        current_unit[:] = [name, "setup"]
        write_lock(f"seed {name}")
        if not quiet:
            progress(f"server {i}/{len(per_server)} {name}: {', '.join(mine)}"
                     f" (total {fmt_secs(time.time() - run_t0)})")
        if not a.force and all(unit_cached(suite, name, a.variants) for suite in mine):
            for suite in mine:
                run_unit(suite, name, a, idle_steps, idle_env)  # records the cached rows; the server is not started
                done_units.add((name, suite))
            continue
        setup_done[0] = 0
        setup_total[0] = len(setup_steps([name], by_name, mine))
        try:
            try:
                reason = setup_server(name, s, by_name, mine)
            except SystemExit as e:
                if isinstance(e.code, str):  # lab.only_one: another lab container would not stop
                    stop(f"VERDICT BLOCKED {name}: {e.code}", suites, names, [])
                raise
            except Exception as e:
                reason = f"{name}: setup {type(e).__name__}: {e}"
            if reason:
                block_server(name, mine, reason)
                continue
            fresh.add(name)
            for suite in mine:
                current_unit[:] = [name, suite]
                run_unit(suite, name, a, idle_steps, idle_env)
                done_units.add((name, suite))
        finally:
            fresh.discard(name)
            if s and s.get("container"):
                current_unit[:] = [name, "teardown"]
                n = len([u for u in plan if u in done_units])
                err = timed_step(f"{name} teardown (stop, rm)", lambda: teardown_server(s),
                                 counter=f"teardown ({n}/{len(plan)} done)")
                if err and container_running(s["container"]):
                    stop(f"VERDICT BLOCKED {name} still running after teardown: {err}", suites, names, [])
            current_unit[:] = ["", ""]
    if not any_skip:
        save_cache()
    verdict = "FAIL" if any(row["result"] in ("FAIL", "BLOCKED") for row in rows) else "PASS"
    write_lock("cleanup")
    write_outputs(verdict, "", [], suites, names)
    finish(f"VERDICT {verdict}", 0)  # exit status unchanged: 0 after a completed run, PASS or FAIL


if __name__ == "__main__":
    atexit.register(cleanup)
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:
        finish(f"VERDICT BLOCKED {type(e).__name__}: {e}")
