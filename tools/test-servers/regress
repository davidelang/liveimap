    login_domain, expect = lab._imap_domain_columns(s["name"])
    if login_domain == "LAB_MAIL_DOMAIN":
        login_domain = lab.mail_domain()
    if not login_domain or not expect:
        return lab.domain_login_problem(s, "")
    account = lab.USER.split("@")[0] + "@" + login_domain
    return lab.domain_login_problem(s, domain_login_reply(s, account))


def probe_servers(used, by_name):
    import lab
