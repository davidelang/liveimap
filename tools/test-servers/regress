def pid_alive(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def write_lock(state):
    parent = os.path.dirname(LOCK_PATH)
    os.makedirs(parent, exist_ok=True)
    tmp = LOCK_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(f"{os.getpid()}\n{state}\n")
    os.replace(tmp, LOCK_PATH)


def acquire_lock():
    global hold_lock
    if os.path.exists(LOCK_PATH):
        try:
            lines = open(LOCK_PATH, encoding="utf-8", errors="replace").read().splitlines()
        except OSError:
            lines = []
        pid = 0
        if lines:
            try:
                pid = int(lines[0].strip())
            except ValueError:
                pid = 0
        if pid_alive(pid):
            print(f"BLOCKED lock held by {pid}")
            sys.exit(1)
    write_lock("starting")
    hold_lock = True


def unescape_prop(s):
    out = []
    i = 0
    while i < len(s):
        if s[i] == "\\" and i + 1 < len(s):
            n = s[i + 1]
            if n == "u" and i + 5 < len(s):
                try:
                    out.append(chr(int(s[i + 2:i + 6], 16)))
                    i += 6
                    continue
                except ValueError:
                    pass
            out.append({"n": "\n", "t": "\t", "r": "\r"}.get(n, n))
            i += 2
            continue
        out.append(s[i])
        i += 1
    return "".join(out)


def sdk_dir():
    path = os.path.join(REPO, "local.properties")
    try:
        lines = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return ""
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or line.startswith("!"):
            continue
        if line.startswith("sdk.dir"):
            raw = line[len("sdk.dir"):].lstrip("=:").strip()
            return unescape_prop(raw)
    return ""


def version_key(name):
    parts = []
    for piece in name.split("."):
        num = ""
        for ch in piece:
            if ch.isdigit():
                num += ch
            else:
                break
        parts.append(int(num) if num else -1)
    return tuple(parts)


def newest_aapt():
    sdk = sdk_dir()
    if not sdk:
        return ""
    root = os.path.join(sdk, "build-tools")
    try:
        names = os.listdir(root)
    except OSError:
        return ""
    found = []
    for name in names:
        path = os.path.join(root, name, "aapt")
        if os.path.isfile(path):
            found.append((version_key(name), path))
    if not found:
        return ""
    found.sort()
    return found[-1][1]


def git_commit_from_xmltree(text):
    """android:value of the meta-data whose android:name is liveimap.gitCommit."""
    in_meta = False
    meta_indent = 0
    name = ""
    value = ""

    def finish():
        if name == "liveimap.gitCommit" and value:
            return value
        return ""

    for line in (text or "").splitlines():
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()
        if in_meta and indent <= meta_indent:
            got = finish()
            if got:
                return got
            in_meta = False
        if stripped.startswith("E:"):
            if in_meta:
                got = finish()
                if got:
                    return got
            in_meta = stripped.startswith("E: meta-data")
            meta_indent = indent
            name = ""
            value = ""
            continue
        if not in_meta:
            continue
        m = re.match(r"A:\s+android:name(?:\([^)]*\))?=\"([^\"]*)\"", stripped)
        if m:
            name = m.group(1)
            continue
        m = re.match(r"A:\s+android:value(?:\([^)]*\))?=\"([^\"]*)\"", stripped)
        if m:
            value = m.group(1)
    if in_meta:
        got = finish()
        if got:
            return got
    return None


def device_apk_path(pkg):
    try:
        r = subprocess.run(["adb", "-s", SERIAL, "shell", "pm", "path", pkg],
                           capture_output=True, text=True, errors="replace", timeout=20)
    except (subprocess.TimeoutExpired, OSError):
        return ""
    if r.returncode != 0:
        return ""
    paths = []
    for line in (r.stdout or "").splitlines():
        line = line.strip()
        if line.startswith("package:"):
            remote = line[len("package:"):].strip()
            if remote:
                paths.append(remote)
    for remote in paths:
        if remote.endswith("/base.apk") or remote.endswith("base.apk"):
            return remote
    return paths[0] if paths else ""


def copy_device_apk(remote, dest):
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "wb") as out:
            r = subprocess.run(["adb", "-s", SERIAL, "exec-out", "cat", remote],
                               stdout=out, stderr=subprocess.PIPE, timeout=120)
    except (subprocess.TimeoutExpired, OSError):
        return False
    if r.returncode != 0:
        return False
    try:
        if os.path.getsize(dest) < 4:
            return False
        with open(dest, "rb") as f:
            if f.read(2) != b"PK":
                return False
    except OSError:
        return False
    return True


