build_volume_servers() {
  case "$server" in
    dovecot-245) build_dovecot_245 ;;
    stalwart|stalwart-01625|stalwart-dev|stalwart-0155) build_stalwart ;;
    zimbra-883) build_zimbra ;;
  esac
}

case "$server" in
  dovecot-245|stalwart|stalwart-01625|stalwart-dev|stalwart-0155|zimbra-883)
