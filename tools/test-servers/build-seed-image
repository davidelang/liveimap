build_stalwart() {
  case "$server" in
    stalwart)
      upstream=stalwartlabs/stalwart:v0.16
      admin_file="$DIR/generated/stalwart-admin.txt"
      ;;
    stalwart-01625)
      upstream=stalwartlabs/stalwart:v0.16.25
      admin_file="$DIR/generated/stalwart-01625-admin.txt"
      ;;
    stalwart-dev)
      upstream=liveimap-stalwart-dev:phase1
      admin_file="$DIR/generated/stalwart-dev-admin.txt"
      if ! docker image inspect "$upstream" >/dev/null; then
        echo "missing $upstream" >&2
        exit 1
      fi
      ;;
    stalwart-0155)
      upstream=stalwartlabs/stalwart:v0.15.5
      admin_file="$DIR/generated/stalwart-0155-admin.txt"
      ;;
  esac
  if [ ! -s "$admin_file" ]; then
    umask 077
    python3 -c 'import secrets; print(secrets.token_hex(16))' > "$admin_file"
    umask 022
  fi
  chmod 600 "$admin_file"
  prepare_volume_work
  token=$(cat "$admin_file")
  printf 'STALWART_RECOVERY_ADMIN=admin:%s\n' "$token" > "$work/stalwart.env"
  chmod 600 "$work/stalwart.env"
  case "$server" in
    stalwart-0155)
      cat > "$work/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
set -a
. /etc/lab/stalwart.env
set +a
if [ ! -x /usr/local/bin/stalwart ]; then
  echo "stalwart binary missing" >&2
  exit 1
fi
if [ ! -f /opt/stalwart/etc/config.toml ]; then
  /usr/local/bin/stalwart --init /opt/stalwart
fi
exec /usr/local/bin/stalwart --config /opt/stalwart/etc/config.toml
EOF
      ;;
    *)
      cat > "$work/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
set -a
. /etc/lab/stalwart.env
set +a
if [ -x /usr/local/bin/stalwart-mail ]; then
  exec /usr/local/bin/stalwart-mail --config /etc/stalwart/config.json
elif [ -x /usr/local/bin/stalwart ]; then
  exec /usr/local/bin/stalwart --config /etc/stalwart/config.json
else
  echo "stalwart binary missing" >&2
  exit 1
fi
EOF
      ;;
  esac
  chmod 755 "$work/entrypoint.sh"
  cat > "$work/Dockerfile" <<EOF
# syntax=docker/dockerfile:1
FROM $upstream AS upstream
FROM debian:bookworm-slim
COPY --from=upstream / /
COPY certs/ /etc/lab/
COPY stalwart.env /etc/lab/stalwart.env
COPY entrypoint.sh /entrypoint.sh
RUN chmod 600 /etc/lab/stalwart.env && chmod 755 /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
EOF
  DOCKER_BUILDKIT=1 docker build -t "liveimap-seed-stage-$server" "$work"
  open_build
  docker commit --change "ENV STALWART_RECOVERY_ADMIN=admin:$token" "liveimap-build-$server" "liveimap-seed-stage-$server"
  docker stop "liveimap-build-$server"
  docker rm -f "liveimap-build-$server"
  open_build
  ready=0
  i=0
  while [ "$i" -lt 120 ]; do
    if docker exec "liveimap-build-$server" /bin/sh -c 'curl -fsS -o /dev/null http://localhost:8080/healthz/live'; then
      ready=1
      break
    fi
    i=$((i + 1))
    sleep 1
  done
  if [ "$ready" -ne 1 ]; then
    echo "stalwart management listener did not open" >&2
    exit 1
  fi
  docker exec -i "liveimap-build-$server" /bin/sh -c 'curl -sS -u "$STALWART_RECOVERY_ADMIN" -H "Content-Type: application/json" --data-binary @- http://localhost:8080/jmap' > "$work/listener.json" <<'JSON'
{"using":["urn:ietf:params:jmap:core","urn:stalwart:jmap"],"methodCalls":[["x:NetworkListener/set",{"create":{"imap143":{"name":"imap","protocol":"imap","bind":{"[::]:143":true},"tlsImplicit":false,"useTls":true}}},"c1"]]}
JSON
  if ! grep -q '"created"' "$work/listener.json"; then
    echo "stalwart imap listener was not created" >&2
    exit 1
  fi
  "$DIR/stalwart-accounts.sh" "liveimap-build-$server"
  close_build
}

build_zimbra() {
  if ! docker image inspect liveimap-zimbra-883:lan >/dev/null; then
    echo "missing liveimap-zimbra-883:lan" >&2
    exit 1
  fi
  prepare_volume_work
  python3 - "$DIR/zimbra-883.sh" "$work/zimbra.env" <<'PY'
import sys
src, dest = sys.argv[1], sys.argv[2]
lines = []
for line in open(src, encoding="utf-8"):
    if line.startswith("python3 "):
        break
    if line.startswith("export ") and "=" in line:
        lines.append(line[len("export "):].rstrip("\n"))
if not lines:
    sys.stderr.write("zimbra setup values missing\n")
    sys.exit(1)
with open(dest, "w", encoding="utf-8") as handle:
    for item in lines:
        handle.write(item + "\n")
PY
  chmod 600 "$work/zimbra.env"
  cat > "$work/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
set -a
. /etc/lab/zimbra.env
set +a
exec /zimbra/init
EOF
  chmod 755 "$work/entrypoint.sh"
  cat > "$work/Dockerfile" <<'EOF'
# syntax=docker/dockerfile:1
FROM liveimap-zimbra-883:lan AS upstream
FROM debian:bookworm-slim
COPY --from=upstream / /
COPY zimbra.env /etc/lab/zimbra.env
COPY entrypoint.sh /entrypoint.sh
RUN chmod 600 /etc/lab/zimbra.env && chmod 755 /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
EOF
  DOCKER_BUILDKIT=1 docker build -t "liveimap-seed-stage-$server" "$work"
  open_build
  python3 - "$DIR/zimbra-883.sh" "$SEED" "liveimap-build-$server" "$lab_host" "$host_port" <<'PY'
import csv
import socket
import subprocess
import sys
import time

script, seed, name, host, port_s = sys.argv[1:]
port = int(port_s)
domain = ""
for line in open(script, encoding="utf-8"):
    if line.startswith("python3 "):
        break
    if line.startswith("export ZIMBRA_DEFAULT_DOMAIN="):
        domain = line.split("=", 1)[1].strip()
if not domain:
    sys.stderr.write("zimbra setup values missing\n")
    sys.exit(1)
users = []
with open(seed, newline="", encoding="utf-8") as handle:
    for row in csv.DictReader(handle, delimiter="\t"):
        if row.get("profile") == "base":
            users.append((row["user"], row["password"]))
deadline = time.time() + 600
opened = False
while time.time() < deadline:
    try:
        sock = socket.create_connection((host, port), 5)
        sock.close()
        opened = True
        break
    except OSError:
        time.sleep(2)
if not opened:
    sys.stderr.write("zimbra imap did not open\n")
    sys.exit(1)
body = (
    "set +x\nexport HOME=/opt/zimbra\nexport PATH=/opt/zimbra/bin:$PATH\n"
    "cd_status=0\n"
    "if ! zmprov gad | grep -qx '%s'; then\n"
    "  zmprov cd '%s'\n"
    "  cd_status=$?\n"
    "fi\n"
    "zmprov mcf zimbraDefaultDomainName '%s'\n"
    "mcf_status=$?\n"
    "if [ \"$mcf_status\" -ne 0 ]; then exit 1; fi\n"
    "if [ \"$cd_status\" -ne 0 ]; then exit \"$cd_status\"; fi\n"
) % (domain, domain, domain)
proc = subprocess.run(
    ["docker", "exec", "-i", "-u", "zimbra", name, "/bin/bash", "-s"],
    input=body, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
)
text = (proc.stdout or "") + (proc.stderr or "")
if proc.returncode != 0 and "already exists" not in text.lower():
    sys.stderr.write("domain create failed\n")
    sys.exit(1)
for user, secret in users:
    addr = "%s@%s" % (user, domain)
    env = dict(**{k: v for k, v in __import__("os").environ.items()})
    env["LIVEIMAP_ADDR"] = addr
    env["LIVEIMAP_ACCOUNT_PW"] = secret
    inner = (
        "set +x\nexport HOME=/opt/zimbra\nexport PATH=/opt/zimbra/bin:$PATH\n"
        "export LANG=C.UTF-8\nexport LC_ALL=C.UTF-8\n"
        'zmprov ca "$LIVEIMAP_ADDR" "$LIVEIMAP_ACCOUNT_PW"\n'
        "status=$?\n"
        'if [ "$status" -ne 0 ]; then\n'
        '  zmprov sp "$LIVEIMAP_ADDR" "$LIVEIMAP_ACCOUNT_PW"\n'
        "fi\n"
    )
    proc = subprocess.run(
        ["docker", "exec", "-i", "-u", "zimbra", "-e", "LIVEIMAP_ADDR", "-e", "LIVEIMAP_ACCOUNT_PW", name, "/bin/bash", "-s"],
        input=inner, text=True, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    text = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode != 0 and "ACCOUNT_EXISTS" not in text and "already exists" not in text.lower():
        sys.stderr.write("account create failed\n")
        sys.exit(1)
PY
  "$DIR/zimbra-tls.sh" "liveimap-build-$server"
  python3 - "$lab_host" "$host_port" "$DIR" "$server" <<'PY'
