#!/bin/sh
# From-scratch lab seed images. Phase 2 builds the non-volume servers.
set -eu
SCRIPT=$(readlink -f "$0")
DIR=$(dirname "$SCRIPT")
cport() {
  python3 "$DIR/cport.py" "$1" "$2" || exit 1
}
if [ $# -ne 1 ] || [ -z "${1:-}" ]; then
  echo "usage: tools/test-servers/build-seed-image <server>" >&2
  exit 1
fi
server=$1
CA="$DIR/generated/ca"
SEED="$DIR/seed/accounts.tsv"
SUMS="$DIR/seed/corpus-v1.sums"
case "$server" in
  cyrus-3124|courier-606|cyrus-3137|dovecot-dev|cyrus-22|cyrus-24|cyrus-25|cyrus-36|dovecot-10|dovecot-12|dovecot-22|courier-50|uwimap|dovecot-245|stalwart|stalwart-01625|stalwart-dev|stalwart-0155|zimbra-883)
    ;;
  *)
    echo "unknown server $server" >&2
    exit 1
    ;;
esac

for f in server.crt server.key ca.crt chain.crt; do
  if [ ! -f "$CA/$f" ]; then
    echo "tools/test-servers/lab-ca.sh" >&2
    exit 1
  fi
done
if [ ! -f "$SEED" ]; then
  echo "tools/test-servers/seed/accounts.tsv" >&2
  exit 1
fi
if [ ! -f "$SUMS" ]; then
  echo "tools/test-servers/seed/corpus-v1.sums" >&2
  exit 1
fi

trap 'docker rm -f "liveimap-build-$server"; exit 1' EXIT

prepare_volume_work() {
  work="$DIR/generated/build-seed/$server"
  rm -rf "$work"
  mkdir -p "$work/certs"
  cp "$CA/server.crt" "$work/certs/server.crt"
  cp "$CA/server.key" "$work/certs/server.key"
  cp "$CA/ca.crt" "$work/certs/ca.crt"
  cp "$CA/chain.crt" "$work/certs/chain.crt"
}

open_build() {
  imap_port=$(cport "$server" imap)
  if docker inspect "liveimap-build-$server" >/dev/null; then
    docker rm -f "liveimap-build-$server"
  fi
  docker create --name "liveimap-build-$server" -p "0:${imap_port}" "liveimap-seed-stage-$server"
  docker start "liveimap-build-$server"
  published=$(docker port "liveimap-build-$server" "$imap_port")
  host_port=${published##*:}
  lab_host=$(awk -F= '$1 == "LAB_BIND" { gsub(/["[:space:]]/, "", $2); print $2; exit }' "$DIR/host.env")
  case "$lab_host" in
    "")
      echo "LAB_BIND missing" >&2
      exit 1
      ;;
  esac
}

require_login() {
  # Bare USER login and the recorded domain login, including zimbra-883.
  python3 - "$lab_host" "$host_port" "$DIR" "$server" <<'PY'
import sys
import time

host, port_s, tools, server = sys.argv[1:]
sys.path.insert(0, tools)
import lab
import imaplib
import ssl
user = lab.USER
secret = lab.PASS
port = int(port_s)
deadline = time.time() + 180
imap = None
while time.time() < deadline:
    try:
        imap = imaplib.IMAP4(host, port, timeout=20)
        break
    except OSError:
        time.sleep(2)
if imap is None:
    sys.stderr.write("bare login no greeting\n")
    sys.exit(1)
try:
    caps = b" ".join(imap.capabilities or [])
    if b"LOGINDISABLED" in caps:
        ctx = ssl._create_unverified_context()
        imap.starttls(ctx)
    typ, data = imap.login(user, secret)
except Exception as exc:
    text = str(exc).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
if typ != "OK":
    text = str(data).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
try:
    imap.logout()
except Exception:
    pass
login_domain, expect = lab._imap_domain_columns(server)
if login_domain == "LAB_MAIL_DOMAIN":
    login_domain = lab.HOSTENV.get("LAB_MAIL_DOMAIN") or ""
    if not login_domain:
        sys.stderr.write("needs LAB_MAIL_DOMAIN\n")
        sys.exit(1)
if not login_domain or not expect:
    problem = lab.domain_login_problem({"name": server}, "")
else:
    account = user.split("@")[0] + "@" + login_domain
    caps = lab.plain_caps(port)
    if caps and "LOGINDISABLED" in caps:
        err = lab._starttls_login(port, account)
        reply = "OK" if not err else err
    else:
        reply = lab._plain_login_reply(port, account)
    problem = lab.domain_login_problem({"name": server}, reply)
if problem:
    sys.stderr.write(problem + "\n")
    sys.exit(1)
PY
}

close_build() {
  require_login
  python3 "$DIR/seed_corpus.py" "$lab_host" "$host_port" --starttls
  docker stop "liveimap-build-$server"
  manifest=$(python3 -c 'import hashlib,pathlib,subprocess,sys; cert,accounts,sums=sys.argv[1:]; fp=subprocess.check_output(["openssl","x509","-in",cert,"-noout","-fingerprint","-sha256"],text=True).strip().split("=",1)[1].replace(":","").lower(); sha=lambda p: hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest(); print("fp=%s,accounts=%s,corpus=%s"%(fp,sha(accounts),sha(sums)))' "$CA/server.crt" "$SEED" "$SUMS")
  docker commit --change "LABEL liveimap.seed-manifest=$manifest" "liveimap-build-$server" "liveimap-seed-$server"
  docker rm -f "liveimap-build-$server"
}

# dovecot-245-build
build_dovecot_245() {
  ports_file="$DIR/generated/local-ports.tsv"
  count=0
  if [ -f "$ports_file" ]; then
    count=$(awk -F '\t' '$1 == "fake-smtp-sink" { n++ } END { print n + 0 }' "$ports_file")
  fi
  if [ "$count" -eq 0 ]; then
    mkdir -p "$DIR/generated"
    cat > "$DIR/generated/draw-one-port.py" <<'PY'
import random
import socket
import subprocess
import sys

path = sys.argv[1]
used = set()
try:
    handle = open(path, encoding="utf-8")
except FileNotFoundError:
    handle = None
if handle is not None:
    for line in handle:
        parts = line.rstrip("\n").split("\t")
        if len(parts) >= 2 and parts[1].isdigit():
            used.add(int(parts[1]))
out = subprocess.check_output(["ss", "-lnt"], text=True, errors="replace")
busy = set()
for line in out.splitlines():
    parts = line.split()
    if len(parts) < 4:
        continue
    got = parts[3].rpartition(":")[2]
    if got.isdigit():
        busy.add(int(got))
for _n in range(400):
    port = random.randint(20000, 39999)
    if port in used or port in busy:
        continue
    sock = socket.socket()
    try:
        sock.bind(("", port))
    except OSError:
        sock.close()
        continue
    sock.close()
    print(port)
    sys.exit(0)
sys.exit(1)
PY
    port=$(python3 "$DIR/generated/draw-one-port.py" "$ports_file")
    printf 'fake-smtp-sink\t%s\t%s\thost\n' "$port" "$port" >> "$ports_file"
  elif [ "$count" -ne 1 ]; then
    echo "fake-smtp-sink row missing in $ports_file" >&2
    exit 1
  else
    port=$(awk -F '\t' '$1 == "fake-smtp-sink" { print $2; exit }' "$ports_file")
  fi
  case "$port" in
    ''|*[!0-9]*)
      echo "fake-smtp-sink row missing in $ports_file" >&2
      exit 1
      ;;
  esac
  relay_port=$port
  gateway=$(docker network inspect bridge -f '{{(index .IPAM.Config 0).Gateway}}')
  if [ -z "$gateway" ]; then
    echo "docker bridge gateway missing" >&2
    exit 1
  fi
  prepare_volume_work
  printf 'submission_relay_host = %s\nsubmission_relay_port = %s\nsubmission_relay_trusted = yes\n' "$gateway" "$relay_port" > "$work/relay.conf"
  cat > "$work/liveimap-setup" <<'EOF'
#!/bin/sh
set -eu
if [ ! -f /run/secrets/accounts ]; then
  echo "accounts secret missing" >&2
  exit 1
fi
mkdir -p /etc/dovecot/conf.d /srv/vmail
umask 027
: > /etc/dovecot/passwd
umask 022
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ""|user*) continue ;;
  esac
  user=$(printf '%s' "$line" | cut -f1)
  pass=$(printf '%s' "$line" | cut -f2)
  profile=$(printf '%s' "$line" | cut -f3)
  if [ "$profile" != base ]; then
    continue
  fi
  printf '%s:{PLAIN}%s\n' "$user" "$pass" >> /etc/dovecot/passwd
  mkdir -p "/srv/vmail/$user/Maildir"
done < /run/secrets/accounts
chmod 640 /etc/dovecot/passwd
cat > /etc/dovecot/auth.conf <<'CFG'
passdb passwd-file {
  passwd_file_path = /etc/dovecot/passwd
}
userdb static {
  fields {
    uid = vmail
    gid = vmail
    home = /srv/vmail/%{user}
  }
}
CFG
conf=/etc/dovecot/dovecot.conf
if [ ! -f "$conf" ]; then
  conf=/usr/local/etc/dovecot/dovecot.conf
fi
if [ -f "$conf" ]; then
  printf '%s\n' '!include /etc/dovecot/auth.conf' '!include /etc/dovecot/conf.d/relay.conf' '# lab-tls' 'ssl = yes' 'ssl_server_cert_file = /etc/lab/chain.crt' 'ssl_server_key_file = /etc/lab/server.key' >> "$conf"
fi
EOF
  chmod 755 "$work/liveimap-setup"
  cat > "$work/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
exec dovecot -F
EOF
  chmod 755 "$work/entrypoint.sh"
  cat > "$work/Dockerfile" <<'EOF'
