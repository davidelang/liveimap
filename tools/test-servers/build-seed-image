#!/bin/sh
# From-scratch lab seed images. Phase 2 builds the non-volume servers.
set -eu
SCRIPT=$(readlink -f "$0")
DIR=$(dirname "$SCRIPT")
cport() {
  python3 "$DIR/cport.py" "$1" "$2" || exit 1
}

ensure_buildx() {
  plugin_home="$DIR/generated/docker-home"
  plugin_dir="$plugin_home/.docker/cli-plugins"
  plugin_bin="$plugin_dir/docker-buildx"
  mkdir -p "$plugin_dir"
  machine=$(uname -m)
  case "$machine" in
    x86_64) asset=amd64 ;;
    aarch64|arm64) asset=arm64 ;;
    *)
      printf '%s\n' "$machine" >&2
      exit 1
      ;;
  esac
  url="https://github.com/docker/buildx/releases/download/v0.38.0/buildx-v0.38.0.linux-$asset"
  if [ ! -x "$plugin_bin" ]; then
    python3 -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$url" "$plugin_bin" || exit 1
    chmod 755 "$plugin_bin"
  fi
  HOME="$plugin_home" docker buildx version || {
    rm -f "$DIR/generated/docker-home/.docker/cli-plugins/docker-buildx"
    printf '%s\n' "$url" "$machine" >&2
    exit 1
  }
}

remove_build_container() {
  names=$(docker ps -a --format '{{.Names}}')
  found=0
  for name in $names; do
    if [ "$name" = "liveimap-build-$server" ]; then
      found=1
    fi
  done
  if [ "$found" -eq 1 ]; then
    docker rm -f "liveimap-build-$server"
  fi
}

if [ $# -eq 1 ] && [ "$1" = "--all" ]; then
  servers=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; sys.stdout.write("\n".join(lab.SEED_SERVERS))' "$DIR") || exit 1
  failed=0
  for server in $servers; do
    printf 'SEED START %s\n' "$server" >&2
    if "$SCRIPT" "$server"; then
      printf 'SEED OK %s\n' "$server" >&2
    else
      printf 'SEED FAIL %s\n' "$server" >&2
      failed=1
    fi
  done
  if [ "$failed" -ne 0 ]; then
    exit 1
  fi
  exit 0
fi
if [ $# -ne 1 ] || [ -z "${1:-}" ]; then
  echo "usage: tools/test-servers/build-seed-image --all|<server>" >&2
  exit 1
fi
server=$1
step() {
  printf 'STEP %s %s\n' "$server" "$*" >&2
}
ensure_buildx
CA="$DIR/generated/ca"
SEED="$DIR/seed/accounts.tsv"
SUMS="$DIR/seed/corpus-v1.sums"
case "$server" in
  cyrus-3124|courier-606|cyrus-3137|dovecot-dev|cyrus-22|cyrus-24|cyrus-25|cyrus-36|dovecot-10|dovecot-12|dovecot-22|courier-50|uwimap|dovecot-245|stalwart|stalwart-01625|stalwart-dev|stalwart-0155|zimbra-883)
    ;;
  *)
    echo "unknown server $server" >&2
    exit 1
    ;;
esac

for f in server.crt server.key ca.crt chain.crt; do
  if [ ! -f "$CA/$f" ]; then
    echo "tools/test-servers/lab-ca.sh" >&2
    exit 1
  fi
done
if [ ! -f "$SEED" ]; then
  echo "tools/test-servers/seed/accounts.tsv" >&2
  exit 1
fi
if [ ! -f "$SUMS" ]; then
  echo "tools/test-servers/seed/corpus-v1.sums" >&2
  exit 1
fi

trap 'remove_build_container; exit 1' EXIT

prepare_volume_work() {
  work="$DIR/generated/build-seed/$server"
  rm -rf "$work"
  mkdir -p "$work/certs"
  cp "$CA/server.crt" "$work/certs/server.crt"
  cp "$CA/server.key" "$work/certs/server.key"
  cp "$CA/ca.crt" "$work/certs/ca.crt"
  cp "$CA/chain.crt" "$work/certs/chain.crt"
}

open_build() {
  step "open build"
  imap_port=$(cport "$server" imap)
  remove_build_container
  docker create --name "liveimap-build-$server" -p "0:${imap_port}" "liveimap-seed-stage-$server"
  docker start "liveimap-build-$server"
  port_out="$DIR/generated/published-$server"
  docker port "liveimap-build-$server" "$imap_port" > "$port_out" || {
    docker logs --tail 80 "liveimap-build-$server" >&2
    printf '%s\n' "liveimap-build-$server is not publishing $imap_port" >&2
    exit 1
  }
  published=$(cat "$port_out")
  host_port=${published##*:}
  lab_host=$(awk -F= '$1 == "LAB_BIND" { gsub(/["[:space:]]/, "", $2); print $2; exit }' "$DIR/host.env")
  case "$lab_host" in
    "")
      echo "LAB_BIND missing" >&2
      exit 1
      ;;
  esac
}

require_login() {
  # Bare USER login and the recorded domain login, including zimbra-883.
  set +e
  python3 - "$lab_host" "$host_port" "$DIR" "$server" <<'PY'
import sys
import time

host, port_s, tools, server = sys.argv[1:]
sys.path.insert(0, tools)
import lab
import imaplib
import ssl
user = lab.USER
secret = lab.PASS
port = int(port_s)
deadline = time.time() + 180
imap = None
last_oserror = ""
while time.time() < deadline:
    try:
        imap = imaplib.IMAP4(host, port, timeout=20)
        break
    except OSError as exc:
        last_oserror = str(exc).replace(secret, "***")
        time.sleep(2)
if imap is None:
    sys.stderr.write("bare login no greeting: %s\n" % last_oserror)
    sys.exit(1)
try:
    parts = []
    for item in imap.capabilities or []:
        if isinstance(item, bytes):
            parts.append(item.decode())
        else:
            parts.append(item)
    caps = " ".join(parts)
    if "LOGINDISABLED" in caps:
        ctx = ssl._create_unverified_context()
        imap.starttls(ctx)
    typ, data = imap.login(user, secret)
except Exception as exc:
    text = str(exc).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
if typ != "OK":
    text = str(data).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
try:
    imap.logout()
except Exception:
    pass
login_domain, expect = lab._imap_domain_columns(server)
if login_domain == "LAB_MAIL_DOMAIN":
    login_domain = lab.mail_domain()
if not login_domain or not expect:
    problem = lab.domain_login_problem({"name": server}, "")
else:
    account = user.split("@")[0] + "@" + login_domain
    caps = lab.plain_caps(port)
    if caps and "LOGINDISABLED" in caps:
        err = lab._starttls_login(port, account)
        reply = "OK" if not err else err
    else:
        reply = lab._plain_login_reply(port, account)
    problem = lab.domain_login_problem({"name": server}, reply)
if problem:
    sys.stderr.write(problem + "\n")
    sys.exit(1)
PY
  login_status=$?
  set -e
  if [ "$login_status" -ne 0 ]; then
    docker logs --tail 80 "liveimap-build-$server" >&2
    exit "$login_status"
  fi
}

seed_suite() {
  python3 "$DIR/lab_imap.py" seed "$lab_host" "$host_port" --tls StartTls --allow "${lab_host}:${host_port}" --count 60
  python3 "$DIR/lab_imap.py" seed-deep "$lab_host" "$host_port" --tls StartTls --allow "${lab_host}:${host_port}"
  python3 "$DIR/lab_imap.py" seed-spoof "$lab_host" "$host_port" --tls StartTls --allow "${lab_host}:${host_port}"
}

close_build() {
  step "require login"
  require_login
  python3 "$DIR/seed_corpus.py" "$lab_host" "$host_port" --starttls
  seed_suite
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; err = lab.store_fixture_marker(sys.argv[2], sys.argv[3]); raise SystemExit(err or None)' "$DIR" "$lab_host" "$host_port"
  docker stop "liveimap-build-$server"
  problem=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; sys.stdout.write(lab.publish_problem(sys.argv[2]))' "$DIR" "$server") || exit 1
  if [ -n "$problem" ]; then printf '%s\n' "$problem" >&2; exit 1; fi
  manifest=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; print(lab.required_fixture_version())' "$DIR") || exit 1
  docker commit --change "LABEL liveimap.seed-manifest=$manifest" "liveimap-build-$server" "liveimap-seed-$server"
  docker rm -f "liveimap-build-$server"
}

phase_pin_ok() {
  dest=$1
  sha=$2
  got=$(git -C "$dest" rev-parse HEAD)
  obj=$(git -C "$dest" rev-parse "$sha")
  want=$(git -C "$dest" rev-parse "${sha}^{commit}")
  if [ "$obj" != "$sha" ] || [ "$got" != "$want" ]; then
    echo "checkout HEAD differs from pin: $dest" >&2
    exit 1
  fi
}

phase_pin_checkout() {
  dest=$1
  url=$2
  sha=$3
  if [ -d "$dest/.git" ]; then
    if git -C "$dest" rev-parse HEAD >/dev/null 2>&1; then
      phase_pin_ok "$dest" "$sha"
      return 0
    fi
    rm -rf "$dest"
  elif [ -e "$dest" ]; then
    echo "checkout path exists without the pin: $dest" >&2
    exit 1
  fi
  mkdir -p "$dest"
  git -C "$dest" init
  git -C "$dest" remote add origin "$url"
  git -C "$dest" fetch --depth 1 origin "$sha"
  git -C "$dest" checkout FETCH_HEAD
  phase_pin_ok "$dest" "$sha"
}
