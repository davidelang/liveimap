courier_one() {
  user=$1
  pass=$2
  if [ "$role" = courier-606 ]; then
    home=/var/mail/$user
    uid=$(cat /etc/lab/courier-uid)
    if ! id "$user" >/dev/null; then
      useradd -M -u "$uid" -d "$home" -s /usr/sbin/nologin "$user"
    fi
    next=$((uid + 1))
    printf '%s\n' "$next" > /etc/lab/courier-uid
    gid=$(id -g "$user")
    uid_now=$(id -u "$user")
  else
    home=/var/vmail/$user
    gid=1000
    uid_now=1000
  fi
  mkdir -p "$home"
  userdb "$user" set "uid=$uid_now" "gid=$gid" "home=$home" "mail=$home/Maildir" >/dev/null
  if printf '%s\n' "$pass" | userdbpw -md5 | userdb "$user" set systempw >/dev/null; then
    if [ ! -d "$home/Maildir" ]; then
      if [ -n "$maildirmake" ]; then
        "$maildirmake" "$home/Maildir"
      fi
    fi
    chown -R "$user:$user" "$home"
    return 0
  fi
  if [ "$user" = liveimap-utf8 ]; then
    echo "utf8 userdb skipped" >&2
    return 0
  fi
  echo "userdb failed" >&2
  exit 1
}

setup_courier() {
  maildirmake=""
  if [ -x /usr/bin/maildirmake ]; then
    maildirmake=/usr/bin/maildirmake
  elif [ -x /usr/bin/maildirmake.courier ]; then
    maildirmake=/usr/bin/maildirmake.courier
  elif [ -x /usr/lib/courier-imap/bin/maildirmake ]; then
    maildirmake=/usr/lib/courier-imap/bin/maildirmake
  else
    echo "maildirmake missing" >&2
    exit 1
  fi
  if [ "$role" = courier-606 ]; then
    printf '%s\n' 2500 > /etc/lab/courier-uid
  fi
  for conf in /etc/courier/authdaemonrc /usr/lib/courier-imap/etc/authdaemonrc; do
    if [ -f "$conf" ]; then
      if grep -q '^authmodulelist' "$conf"; then
        sed -i 's/^authmodulelist=.*/authmodulelist="authuserdb"/' "$conf"
      else
        echo 'authmodulelist="authuserdb"' >> "$conf"
      fi
    fi
  done
  for imapd in /etc/courier/imapd /usr/lib/courier-imap/etc/imapd; do
    if [ -f "$imapd" ]; then
      sed -i 's/^ADDRESS=0\.0\.0\.0$/ADDRESS=0/' "$imapd"
      if ! grep -q '^PORT=' "$imapd"; then
        echo 'PORT=143' >> "$imapd"
      fi
    fi
  done
  cat /etc/lab/server.key /etc/lab/server.crt /etc/lab/ca.crt > /etc/lab/courier.pem
  chmod 600 /etc/lab/courier.pem
  if id courier >/dev/null; then
    chown courier:courier /etc/lab/courier.pem
  elif id daemon >/dev/null; then
    chown daemon /etc/lab/courier.pem
  fi
  for f in /etc/courier/imapd-ssl /usr/lib/courier-imap/etc/imapd-ssl; do
    if [ -f "$f" ]; then
      sed -i 's|^TLS_CERTFILE=.*|TLS_CERTFILE=/etc/lab/courier.pem|' "$f"
      sed -i '/^IMAP_STARTTLS=/d' "$f"
      if ! grep -q '^TLS_CERTFILE=' "$f"; then
        echo 'TLS_CERTFILE=/etc/lab/courier.pem' >> "$f"
      fi
      echo 'IMAP_STARTTLS=YES' >> "$f"
    fi
  done
  each_base courier_one
  makeuserdb
}

setup_uw() {
  uw_one() {
    user=$1
    pass=$2
    if ! id "$user" >/dev/null; then
      useradd -m -s /usr/sbin/nologin "$user"
    fi
    touch "/home/$user/mbox" "/var/mail/$user"
    chown "$user:$user" "/home/$user/mbox" "/var/mail/$user"
    if printf '%s:%s\n' "$user" "$pass" | chpasswd; then
      return 0
    fi
    if [ "$user" = liveimap-utf8 ]; then
      echo "utf8 chpasswd skipped" >&2
      return 0
    fi
    echo "chpasswd failed" >&2
    exit 1
  }
  each_base uw_one
  if [ -f /etc/inetd.conf ] && grep -q '^#.*imap' /etc/inetd.conf; then
    sed -i '/imap/s/^#//' /etc/inetd.conf
  fi
  cat /etc/lab/server.key /etc/lab/server.crt /etc/lab/ca.crt > /etc/ssl/certs/imapd.pem
  mkdir -p /etc/ssl/private
  cp /etc/ssl/certs/imapd.pem /etc/ssl/private/imapd.pem
  printf '%s\n' 'I accept the risk' 'set disable-plaintext nil' > /etc/c-client.cf
}

