#!/bin/sh
# From-scratch lab seed images. Phase 2 builds the non-volume servers.
set -eu
SCRIPT=$(readlink -f "$0")
DIR=$(dirname "$SCRIPT")
cport() {
  python3 "$DIR/cport.py" "$1" "$2" || exit 1
}

ensure_buildx() {
  plugin_home="$DIR/generated/docker-home"
  plugin_dir="$plugin_home/.docker/cli-plugins"
  plugin_bin="$plugin_dir/docker-buildx"
  mkdir -p "$plugin_dir"
  machine=$(uname -m)
  case "$machine" in
    x86_64) asset=amd64 ;;
    aarch64|arm64) asset=arm64 ;;
    *)
      printf '%s\n' "$machine" >&2
      exit 1
      ;;
  esac
  url=$(python3 "$DIR/upstream_pins.py" url "docker-buildx-$asset")
  python3 "$DIR/upstream_pins.py" fetch "docker-buildx-$asset" "$plugin_bin"
  chmod 755 "$plugin_bin"
  HOME="$plugin_home" docker buildx version || {
    rm -f "$DIR/generated/docker-home/.docker/cli-plugins/docker-buildx"
    printf '%s\n' "$url" "$machine" >&2
    exit 1
  }
}

remove_build_container() {
  names=$(docker ps -a --format '{{.Names}}')
  found=0
  for name in $names; do
    if [ "$name" = "liveimap-build-$server" ]; then
      found=1
    fi
  done
  if [ "$found" -eq 1 ]; then
    docker rm -f "liveimap-build-$server"
  fi
}

if [ $# -eq 1 ] && [ "$1" = "--all" ]; then
  servers=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; sys.stdout.write("\n".join(lab.SEED_SERVERS))' "$DIR") || exit 1
  failed=0
  for server in $servers; do
    printf 'SEED START %s\n' "$server" >&2
    if "$SCRIPT" "$server"; then
      printf 'SEED OK %s\n' "$server" >&2
    else
      printf 'SEED FAIL %s\n' "$server" >&2
      failed=1
    fi
  done
  if [ "$failed" -ne 0 ]; then
    exit 1
  fi
  exit 0
fi
if [ $# -ne 1 ] || [ -z "${1:-}" ]; then
  echo "usage: tools/test-servers/build-seed-image --all|<server>" >&2
  exit 1
fi
server=$1
# One free host port per build container, fixed at create so a restart keeps it (never -p 0).
build_host_port() {
  python3 "$DIR/build_host_port.py" "$DIR/generated/local-ports.tsv"
}

step() {
  printf 'STEP %s %s\n' "$server" "$*" >&2
}
ensure_buildx
CA="$DIR/generated/ca"
SEED="$DIR/seed/accounts.tsv"
SUMS="$DIR/seed/corpus-v1.sums"
case "$server" in
  cyrus-3124|courier-606|cyrus-3137|dovecot-dev|cyrus-22|cyrus-24|cyrus-25|cyrus-36|dovecot-10|dovecot-12|dovecot-22|courier-50|uwimap|dovecot-245|stalwart|stalwart-01625|stalwart-dev|stalwart-0155|zimbra-883)
    ;;
  *)
    echo "unknown server $server" >&2
    exit 1
    ;;
esac

for f in server.crt server.key ca.crt chain.crt; do
  if [ ! -f "$CA/$f" ]; then
    echo "tools/test-servers/lab-ca.sh" >&2
    exit 1
  fi
done
# The lab certificate is generated on the host (lab-ca.sh, generated/ca, not checked in) and copied into the image
# here. It must name every host the lab needs; the image records its fingerprint (label liveimap.cert-sha256).
python3 "$DIR/lab_cert.py" check
cert_sha=$(python3 "$DIR/lab_cert.py" fingerprint)
if [ ! -f "$SEED" ]; then
  echo "tools/test-servers/seed/accounts.tsv" >&2
  exit 1
fi
if [ ! -f "$SUMS" ]; then
  echo "tools/test-servers/seed/corpus-v1.sums" >&2
  exit 1
fi

trap 'remove_build_container; exit 1' EXIT

prepare_volume_work() {
  work="$DIR/generated/build-seed/$server"
  rm -rf "$work"
  mkdir -p "$work/certs"
  cp "$CA/server.crt" "$work/certs/server.crt"
  cp "$CA/server.key" "$work/certs/server.key"
  cp "$CA/ca.crt" "$work/certs/ca.crt"
  cp "$CA/chain.crt" "$work/certs/chain.crt"
}

open_build() {
  step "open build"
  imap_port=$(cport "$server" imap)
  remove_build_container
  case "$server" in
    zimbra-883)
      seed_hostname=zimbra.zcs-foss.test
      build_port=$(build_host_port)
      docker create --hostname "$seed_hostname" --name "liveimap-build-$server" -p "${build_port}:${imap_port}" "liveimap-seed-stage-$server"
      ;;
    *)
      build_port=$(build_host_port)
      docker create --name "liveimap-build-$server" -p "${build_port}:${imap_port}" "liveimap-seed-stage-$server"
      ;;
  esac
  docker start "liveimap-build-$server"
  port_out="$DIR/generated/published-$server"
  docker port "liveimap-build-$server" "$imap_port" > "$port_out" || {
    docker logs --tail 80 "liveimap-build-$server" >&2
    printf '%s\n' "liveimap-build-$server is not publishing $imap_port" >&2
    exit 1
  }
  published=$(cat "$port_out")
  host_port=${published##*:}
  lab_host=$(awk -F= '$1 == "LAB_BIND" { gsub(/["[:space:]]/, "", $2); print $2; exit }' "$DIR/host.env")
  case "$lab_host" in
    "")
      echo "LAB_BIND missing" >&2
      exit 1
      ;;
  esac
}

require_login() {
  # Bare USER login and the recorded domain login, including zimbra-883.
  set +e
  python3 - "$lab_host" "$host_port" "$DIR" "$server" <<'PY'
import sys
import time

host, port_s, tools, server = sys.argv[1:]
sys.path.insert(0, tools)
import lab
import imaplib
import ssl
user = lab.USER
secret = lab.PASS
port = int(port_s)
deadline = time.time() + 180
imap = None
last_oserror = ""
while time.time() < deadline:
    try:
        imap = imaplib.IMAP4(host, port, timeout=20)
        break
    except OSError as exc:
        last_oserror = str(exc).replace(secret, "***")
        time.sleep(2)
if imap is None:
    sys.stderr.write("bare login no greeting: %s\n" % last_oserror)
    sys.exit(1)
try:
    parts = []
    for item in imap.capabilities or []:
        if isinstance(item, bytes):
            parts.append(item.decode())
        else:
            parts.append(item)
    caps = " ".join(parts)
    if "STARTTLS" in caps:  # Stalwart 0.15 refuses clear-text LOGIN without advertising LOGINDISABLED
        imap.starttls(lab._lab_ssl())
    typ, data = imap.login(user, secret)
except Exception as exc:
    text = str(exc).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
if typ != "OK":
    text = str(data).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
try:
    imap.logout()
except Exception:
    pass
login_domain, expect = lab._imap_domain_columns(server)
if login_domain == "LAB_MAIL_DOMAIN":
    login_domain = lab.mail_domain()
if not login_domain or not expect:
    problem = lab.domain_login_problem({"name": server}, "")
else:
    account = user.split("@")[0] + "@" + login_domain
    caps = lab.plain_caps(port)
    if caps and "STARTTLS" in caps:
        err = lab._starttls_login(port, account)
        reply = "OK" if not err else err
    else:
        reply = lab._plain_login_reply(port, account)
    problem = lab.domain_login_problem({"name": server}, reply)
if problem:
    sys.stderr.write(problem + "\n")
    sys.exit(1)
PY
  login_status=$?
  set -e
  if [ "$login_status" -ne 0 ]; then
    docker logs --tail 80 "liveimap-build-$server" >&2
    exit "$login_status"
  fi
}

seed_suite() {
  python3 "$DIR/lab_imap.py" seed "$lab_host" "$host_port" --tls StartTls --allow "${lab_host}:${host_port}" --count 60
  python3 "$DIR/lab_imap.py" seed-deep "$lab_host" "$host_port" --tls StartTls --allow "${lab_host}:${host_port}"
  python3 "$DIR/lab_imap.py" seed-spoof "$lab_host" "$host_port" --tls StartTls --allow "${lab_host}:${host_port}"
}

close_build() {
  step "require login"
  require_login
  python3 "$DIR/seed_corpus.py" "$lab_host" "$host_port" --starttls
  seed_suite
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; err = lab.store_fixture_marker(sys.argv[2], sys.argv[3]); raise SystemExit(err or None)' "$DIR" "$lab_host" "$host_port"
  step "audit seed contents"
  python3 "$DIR/seed_audit.py" live "$server" "$lab_host" "$host_port"
  audit=$(python3 "$DIR/seed_audit.py" inputs)
  docker stop "liveimap-build-$server"
  problem=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; sys.stdout.write(lab.publish_problem(sys.argv[2]))' "$DIR" "$server") || exit 1
  if [ -n "$problem" ]; then printf '%s\n' "$problem" >&2; exit 1; fi
  manifest=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import lab; print(lab.required_fixture_version())' "$DIR") || exit 1
  docker commit --change "LABEL liveimap.seed-manifest=$manifest" --change "LABEL liveimap.hostname=${seed_hostname:-}" --change "LABEL liveimap.cert-sha256=$cert_sha" --change "LABEL liveimap.audit=$audit" "liveimap-build-$server" "liveimap-seed-$server"
  if ! python3 "$DIR/seed_audit.py" image "$server"; then
    docker rmi "liveimap-seed-$server"  # a seed image that fails its audit is never left for the lab
    exit 1
  fi
  docker rm -f "liveimap-build-$server"
}

phase_pin_ok() {
  dest=$1
  sha=$2
  got=$(git -C "$dest" rev-parse HEAD)
  obj=$(git -C "$dest" rev-parse "$sha")
  want=$(git -C "$dest" rev-parse "${sha}^{commit}")
  if [ "$obj" != "$sha" ] || [ "$got" != "$want" ]; then
    echo "checkout HEAD differs from pin: $dest" >&2
    exit 1
  fi
}

phase_pin_checkout() {
  dest=$1
  url=$2
  sha=$3
  if [ -d "$dest/.git" ]; then
    if git -C "$dest" rev-parse HEAD >/dev/null 2>&1; then
      phase_pin_ok "$dest" "$sha"
      return 0
    fi
    rm -rf "$dest"
  elif [ -e "$dest" ]; then
    echo "checkout path exists without the pin: $dest" >&2
    exit 1
  fi
  mkdir -p "$dest"
  git -C "$dest" init
  git -C "$dest" remote add origin "$url"
  git -C "$dest" fetch --depth 1 origin "$sha"
  git -C "$dest" checkout FETCH_HEAD
  phase_pin_ok "$dest" "$sha"
}
build_latest_phase() {
  tag=$1
  GEN="$DIR/generated"
  CY_BUILD="$GEN/cyrus-3124-build"
  CO_BUILD="$GEN/courier-606-build"
  mkdir -p "$GEN" "$CY_BUILD" "$CO_BUILD"
echo "downloading tarballs (checked against upstream-pins.tsv)"
python3 "$DIR/upstream_pins.py" fetch cyrus-imapd-3.12.4.tar.gz "$CY_BUILD/cyrus-imapd-3.12.4.tar.gz"
python3 "$DIR/upstream_pins.py" fetch courier-imap-6.0.6.tar.bz2 "$CO_BUILD/courier-imap-6.0.6.tar.bz2"
python3 "$DIR/upstream_pins.py" fetch courier-unicode-2.6.0.tar.bz2 "$CO_BUILD/courier-unicode-2.6.0.tar.bz2"

echo "preparing cyrus image"
cat > "$CY_BUILD/xxd" <<'EOF'
#!/bin/sh
set -eu
if [ "${1:-}" != "-i" ] || [ -z "${2:-}" ]; then
  echo "xxd: only -i FILE is implemented" >&2
  exit 1
fi
file=$2
sym=$(printf '%s' "$file" | sed 's/[^A-Za-z0-9]/_/g')
size=$(wc -c < "$file" | tr -d ' ')
echo "unsigned char ${sym}[] = {"
od -An -tx1 -v "$file" | awk '
  {
    for (i = 1; i <= NF; i++) {
      printf "  0x%s,", $i
      n++
      if (n % 12 == 0) printf "\n"
    }
  }
  END { if (n % 12 != 0) printf "\n" }
'
echo "};"
echo "unsigned int ${sym}_len = ${size};"
EOF
cat > "$CY_BUILD/rsync" <<'EOF'
#!/bin/sh
# Present for configure. Cyrus calls rsync only to copy search indexes.
exit 0
EOF
chmod 755 "$CY_BUILD/xxd" "$CY_BUILD/rsync"
cat > "$CY_BUILD/imapd.conf" <<'EOF'
configdirectory: /var/lib/cyrus
partition-default: /var/spool/cyrus/mail
sievedir: /var/spool/cyrus/sieve
admins: cyrus
allowplaintext: yes
sasl_pwcheck_method: auxprop
sasl_mech_list: PLAIN LOGIN
httpmodules: jmap
conversations: 1
conversations_db: twoskip
unixhierarchysep: yes
virtdomains: off
sasl_minimum_layer: 0
EOF
cat > "$CY_BUILD/cyrus.conf" <<'EOF'
START {
  recover       cmd="ctl_cyrusdb -r"
}

SERVICES {
  imap          cmd="imapd" listen="143" prefork=0
  http          cmd="httpd" listen="8080" prefork=0
}

EVENTS {
  checkpoint    cmd="ctl_cyrusdb -c" period=30
}
EOF
cat > "$CY_BUILD/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
master=""
if [ -x /usr/sbin/cyrmaster ]; then
  master=/usr/sbin/cyrmaster
else
  for cand in /usr/local/cyrus/libexec/master /usr/local/cyrus/sbin/master /usr/local/cyrus/bin/master /usr/sbin/master; do
    if [ -x "$cand" ]; then
      master=$cand
      break
    fi
  done
fi
if [ -z "$master" ]; then
  echo "cyrus master missing" >&2
  exit 1
fi
rm -f /var/run/cyrus-master.pid /run/cyrus-master.pid /var/run/cyrmaster.pid /run/cyrus/master.pid
# Unix-socket listeners (lmtpunix, notify) need their directory; /run is empty in a fresh container.
cyrus_socks=$(sed -n 's/.*listen="\(\/[^"]*\)".*/\1/p' /etc/cyrus.conf)
for sock in $cyrus_socks; do
  mkdir -p "${sock%/*}"
  chown cyrus "${sock%/*}"
done
exec "$master"  # foreground: docker stop reaches master, its stderr is docker logs

EOF
chmod 755 "$CY_BUILD/entrypoint.sh"
cp "$DIR/images/cyrus-3124/Dockerfile" "$CY_BUILD/Dockerfile"

echo "preparing courier image"
cat > "$CO_BUILD/build-inside.sh" <<'EOF'
#!/bin/sh
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get update
# The 6.0.6 tarball is bzip2. bookworm tar does not include that decompressor.
apt-get install -y --no-install-recommends bzip2
tar -xjf /src/courier-imap-6.0.6.tar.bz2 -C /src
cd /src
# courier-debuild reads mailuser from courierauthconfig before debuild names
# packages. This stub only exists so the first run can reach that list.
cat > /usr/local/bin/courierauthconfig <<'STUB'
#!/bin/sh
echo mailuser=courier
echo mailgroup=courier
STUB
chmod 755 /usr/local/bin/courierauthconfig
cd /src/courier-imap-6.0.6
# Bookworm ships these names. Patch the control file courier-debuild copies.
sed -i \
  -e 's/libcourier-auth-dev/courier-authlib-dev/' \
  -e 's/gnutls-dev/libgnutls28-dev/' \
  -e 's/libgcrypt-dev/libgcrypt20-dev/' \
  -e '/^Pre-Depends:/d' \
  packaging/debian/control
# Unicode 2.6 is installed from the tarball, so it has no dpkg shlibs.
printf '\noverride_dh_shlibdeps:\n\tdh_shlibdeps -- --ignore-missing-info\n' >> packaging/debian/rules
# courier-debuild unpacks the tarball again and ignores this tree.
cd /src
tar -cjf courier-imap-6.0.6.tar.bz2 courier-imap-6.0.6
cd /src/courier-imap-6.0.6
# configure.ac rejects a bare "ps" name. procps provides /bin/ps.
apt-get install -y procps
if [ ! -x /bin/ps ] && [ ! -x /usr/bin/ps ]; then
  echo "procps did not install ps" >&2
  exit 1
fi
set +e
DEBGCC=default ./courier-debuild -us -uc > /tmp/debuild1.log 2>&1
code=$?
set -e
if grep -q 'Cannot find pathname to ps' /tmp/debuild1.log; then
  echo "Cannot find pathname to ps" >&2
  exit 1
fi
if [ "$code" -ne 0 ]; then
  if [ -f /src/courier-imap-6.0.6/deb/courier-imap-6.0.6/debian/control ]; then
    ctl=/src/courier-imap-6.0.6/deb/courier-imap-6.0.6/debian/control
  else
    ctl=/src/courier-imap-6.0.6/packaging/debian/control
  fi
  awk '
    BEGIN { p = 0 }
    /^Build-Depends:/ { p = 1; sub(/^Build-Depends:[[:space:]]*/, ""); printf "%s", $0; next }
    p && /^[^[:space:]]/ { p = 0 }
    p { sub(/^[[:space:]]*/, ""); printf " %s", $0 }
    END { printf "\n" }
  ' "$ctl" > /tmp/build-depends.txt
  if grep -Eq 'debuild: (command )?not found|Cannot determine gcc version' /tmp/debuild1.log \
      || ! grep -q 'Unmet build dependencies' /tmp/debuild1.log; then
    printf '%s\n' devscripts >> /tmp/build-depends.txt
  fi
  python3 - <<'PY' || apt-get install -y python3
import sys
print("python-ok")
PY
  python3 - <<'PY'
import os
import re
import subprocess
import textwrap

lines = [
    line.strip()
    for line in open("/tmp/build-depends.txt", encoding="utf-8", errors="replace")
    if line.strip()
]
pkgs = []
if lines:
    for part in lines[0].split(","):
        part = re.sub(r"\s+", " ", part).strip()
        if part and not part.startswith("%"):
            pkgs.append(part)
    for line in lines[1:]:
        part = re.sub(r"\s+", " ", line).strip().strip(",")
        if part and not part.startswith("%"):
            pkgs.append(part)
# debuild itself
if "devscripts" not in " ".join(pkgs):
    if os.path.exists("/tmp/debuild1.log"):
        log = open("/tmp/debuild1.log", encoding="utf-8", errors="replace").read()
        if "debuild" in log and "not found" in log:
            pkgs.append("devscripts")
wanted = []
seen = set()
for pkg in pkgs:
    if pkg not in seen:
        seen.add(pkg)
        wanted.append(pkg)
if not wanted:
    raise SystemExit("courier-debuild failed without naming packages")
print("installing", " ".join(wanted))
subprocess.check_call(["apt-get", "satisfy", "-y"] + wanted)
PY
  # Bookworm's libcourier-unicode 2.1 copies output iterators. 6.0.6's
  # rfc822 iterators are not copyable. Unicode 2.6 takes them by reference.
  apt-get install -y build-essential locales
  printf '%s\n' 'en_US.UTF-8 UTF-8' 'en_US ISO-8859-1' > /etc/locale.gen
  locale-gen
  tar -xjf /src/courier-unicode-2.6.0.tar.bz2 -C /src
  cd /src/courier-unicode-2.6.0
  # Multiarch searches this directory before /usr/lib. Replace Bookworm's .so.
  ./configure --prefix=/usr --libdir=/usr/lib/x86_64-linux-gnu
  make -j4
  make install
  ldconfig
  rm -f /usr/local/bin/courierauthconfig
  if ! hash -r; then
    :
  fi
  cd /src/courier-imap-6.0.6
  export MAKEFLAGS=-j4
  # Upstream make check needs both en_US locales and still mismatches Bookworm.
  export DEB_BUILD_OPTIONS=parallel=4,nocheck
  DEBGCC=default ./courier-debuild -us -uc
fi
rm -f /usr/local/bin/courierauthconfig
debs=$(find /src -name '*.deb' -type f | grep -v -- '-dbgsym' || printf '')
if [ -z "$debs" ]; then
  echo "courier deb missing" >&2
  exit 1
fi
for deb in $debs; do
  apt-get install -y "$deb" || dpkg -i "$deb"
done
apt-get install -y -f
if ! find /usr -name 'authuserdb*' | grep -q .; then
  apt-get install -y courier-authlib-userdb
fi
EOF
chmod 755 "$CO_BUILD/build-inside.sh"
cat > "$CO_BUILD/entrypoint.sh" <<'EOF'
#!/bin/sh
set -eu
if [ -x /usr/sbin/rsyslogd ] && [ ! -S /dev/log ]; then
  rm -f /var/run/rsyslogd.pid
  rsyslogd
fi
if [ -x /etc/init.d/courier-authdaemon ]; then
  /etc/init.d/courier-authdaemon start
elif [ -x /etc/init.d/courier-auth ]; then
  /etc/init.d/courier-auth start
elif [ -x /usr/lib/courier-imap/sbin/authdaemond ]; then
  /usr/lib/courier-imap/sbin/authdaemond start
elif [ -x /usr/lib/courier/courier-authlib/authdaemond ]; then
  /usr/lib/courier/courier-authlib/authdaemond start
else
  echo "courier authdaemon missing" >&2
  find /usr /etc -name 'authdaemond' -o -name 'authdaemon*'
  exit 1
fi
if [ -x /etc/init.d/courier-imap ]; then
  /etc/init.d/courier-imap start
elif [ -x /usr/lib/courier-imap/libexec/imapd.rc ]; then
  /usr/lib/courier-imap/libexec/imapd.rc start
elif [ -x /etc/init.d/courier-imapd ]; then
  /etc/init.d/courier-imapd start
