    "if [ \"$mcf_status\" -ne 0 ]; then exit 1; fi\n"
    "if [ \"$cd_status\" -ne 0 ]; then exit \"$cd_status\"; fi\n"
) % (domain, domain, domain)
proc = subprocess.run(
    ["docker", "exec", "-i", "-u", "zimbra", name, "/bin/bash", "-s"],
    input=body, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
)
text = (proc.stdout or "") + (proc.stderr or "")
if proc.returncode != 0 and "already exists" not in text.lower():
    sys.stderr.write("domain create failed\n")
    sys.exit(1)
for user, secret in users:
