}

each_base() {
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|user*) continue ;;
    esac
    user=$(printf '%s' "$line" | cut -f1)
    pass=$(printf '%s' "$line" | cut -f2)
    profile=$(printf '%s' "$line" | cut -f3)
    if [ "$profile" != base ]; then
      continue
    fi
    "$1" "$user" "$pass"
  done < /run/secrets/accounts
}

set_key() {
  file=$1
  key=$2
  value=$3
  sep=$4
  if grep -q "^${key}${sep}" "$file"; then
    sed -i "s|^${key}${sep}.*|${key}${sep}${value}|" "$file"
  else
    printf '%s%s%s\n' "$key" "$sep" "$value" >> "$file"
  fi
}

setup_cyrus() {
  sep=$1
  http=$2
  tls_modern=$3
  printf '%s\n' "$sep" > /etc/lab/mbox-sep
  if ! id cyrus >/dev/null; then
    useradd -r -d /var/lib/cyrus -s /usr/sbin/nologin cyrus
  fi
  mkdir -p /var/lib/cyrus /var/spool/cyrus/mail /var/spool/cyrus/sieve /run/cyrus /etc/sasl2 /usr/lib/sasl2
  cyrus_group=$(id -gn cyrus)
  chown -R "cyrus:$cyrus_group" /var/lib/cyrus /var/spool/cyrus /run/cyrus
  sasl_body='pwcheck_method: auxprop
auxprop_plugin: sasldb
mech_list: plain login
sasldb_path: /etc/sasldb2'
  printf '%s\n' "$sasl_body" > /etc/sasl2/Cyrus.conf
  if [ -d /usr/lib/x86_64-linux-gnu/sasl2 ]; then
    cp /etc/sasl2/Cyrus.conf /usr/lib/x86_64-linux-gnu/sasl2/Cyrus.conf
  fi
  cp /etc/sasl2/Cyrus.conf /usr/lib/sasl2/Cyrus.conf
  if [ -f /etc/cyrus.conf ]; then
    sed -i 's/^\t#idled\t\tcmd="idled"/\tidled\t\tcmd="idled"/' /etc/cyrus.conf
  fi
  if [ -f /etc/imapd.conf ]; then
    sed -i 's/^idlemethod: poll/idlemethod: idled/' /etc/imapd.conf
    set_key /etc/imapd.conf allowplaintext " yes" ":"
    set_key /etc/imapd.conf sasl_pwcheck_method " auxprop" ":"
    set_key /etc/imapd.conf sasl_mech_list " PLAIN LOGIN" ":"
    set_key /etc/imapd.conf admins " cyrus" ":"
    set_key /etc/imapd.conf sasl_minimum_layer " 0" ":"
    if [ "$sep" = / ]; then
      set_key /etc/imapd.conf unixhierarchysep " yes" ":"
    fi
    if [ "$tls_modern" = yes ]; then
      set_key /etc/imapd.conf tls_server_cert " /etc/lab/chain.crt" ":"
      set_key /etc/imapd.conf tls_server_key " /etc/lab/server.key" ":"
      set_key /etc/imapd.conf allowstarttls " yes" ":"
    else
      set_key /etc/imapd.conf tls_cert_file " /etc/lab/chain.crt" ":"
      set_key /etc/imapd.conf tls_key_file " /etc/lab/server.key" ":"
    fi
    if [ "$http" = yes ] && [ -f /etc/cyrus.conf ]; then
      if grep -q 'listen="8008"' /etc/cyrus.conf; then
        sed -i 's/listen="8008"/listen="8080"/' /etc/cyrus.conf
      fi
    fi
  fi
  for bin in pop3d nntpd; do
    if [ ! -x "/usr/lib/cyrus/bin/$bin" ] && [ ! -x "/usr/sbin/$bin" ]; then
      if [ -f /etc/cyrus.conf ]; then
        sed -i "/^[[:space:]]*[^#].*${bin}/s/^/#/" /etc/cyrus.conf
      fi
    fi
  done
  if [ "$http" != yes ] && [ -f /etc/cyrus.conf ]; then
    if [ ! -x /usr/lib/cyrus/bin/httpd ] && [ ! -x /usr/sbin/httpd ]; then
      sed -i '/^[[:space:]]*[^#].*httpd/s/^/#/' /etc/cyrus.conf
    fi
  fi
  write_cyrus_admin
  admin=$(cat /etc/lab/cyrus-admin)
  printf '%s\n' "$admin" | saslpasswd2 -p -c cyrus
  cyrus_one() {
    user=$1
    pass=$2
    if printf '%s\n' "$pass" | saslpasswd2 -p -c "$user"; then
      return 0
    fi
    if [ "$user" = liveimap-utf8 ]; then
      echo "utf8 sasl skipped" >&2
      return 0
    fi
    echo "sasl user failed" >&2
    exit 1
  }
  each_base cyrus_one
  unset admin
  if grep -q '^sasl:' /etc/group; then
    chown cyrus:sasl /etc/sasldb2
  else
    chown cyrus /etc/sasldb2
  fi
  chmod 640 /etc/sasldb2
  ctl=""
  for cand in /usr/lib/cyrus/bin/ctl_cyrusdb /usr/sbin/ctl_cyrusdb /usr/local/cyrus/bin/ctl_cyrusdb /usr/local/cyrus/sbin/ctl_cyrusdb; do
    if [ -x "$cand" ]; then
      ctl=$cand
      break
    fi
  done
  if [ -z "$ctl" ]; then
    echo "ctl_cyrusdb missing" >&2
    exit 1
  fi
  su -s /bin/sh cyrus -c "$ctl -r"
}

