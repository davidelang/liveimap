import csv
import socket
import subprocess
import sys
import time

script, seed, name, host, port_s = sys.argv[1:]
port = int(port_s)
domain = ""
for line in open(script, encoding="utf-8"):
    if line.startswith("ZIMBRA_DEFAULT_DOMAIN="):
        domain = line.split("=", 1)[1].strip()
if not domain:
    sys.stderr.write("zimbra setup values missing\n")
    sys.exit(1)
users = []
with open(seed, newline="", encoding="utf-8") as handle:
    for row in csv.DictReader(handle, delimiter="\t"):
        if row.get("profile") == "base":
            users.append((row["user"], row["password"]))
deadline = time.time() + 600
opened = False
while time.time() < deadline:
    try:
        sock = socket.create_connection((host, port), 5)
        sock.close()
        opened = True
        break
    except OSError:
        time.sleep(2)
if not opened:
    sys.stderr.write("zimbra imap did not open\n")
    sys.exit(1)
body = (
    "set +x\nexport HOME=/opt/zimbra\nexport PATH=/opt/zimbra/bin:$PATH\n"
    "cd_status=0\n"
    "if ! zmprov gad | grep -qx '%s'; then\n"
    "  zmprov cd '%s'\n"
    "  cd_status=$?\n"
    "fi\n"
    "zmprov mcf zimbraDefaultDomainName '%s'\n"
    "mcf_status=$?\n"
    "if [ \"$mcf_status\" -ne 0 ]; then exit 1; fi\n"
    "if [ \"$cd_status\" -ne 0 ]; then exit \"$cd_status\"; fi\n"
) % (domain, domain, domain)
proc = subprocess.run(
    ["docker", "exec", "-i", "-u", "zimbra", name, "/bin/bash", "-s"],
    input=body, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
)
text = (proc.stdout or "") + (proc.stderr or "")
if proc.returncode != 0 and "already exists" not in text.lower():
    sys.stderr.write("domain create failed\n")
    sys.exit(1)
for user, secret in users:
    addr = "%s@%s" % (user, domain)
    env = dict(**{k: v for k, v in __import__("os").environ.items()})
    env["LIVEIMAP_ADDR"] = addr
    env["LIVEIMAP_ACCOUNT_PW"] = secret
    inner = (
        "set +x\nexport HOME=/opt/zimbra\nexport PATH=/opt/zimbra/bin:$PATH\n"
        "export LANG=C.UTF-8\nexport LC_ALL=C.UTF-8\n"
        'zmprov ca "$LIVEIMAP_ADDR" "$LIVEIMAP_ACCOUNT_PW"\n'
        "status=$?\n"
        'if [ "$status" -ne 0 ]; then\n'
        '  zmprov sp "$LIVEIMAP_ADDR" "$LIVEIMAP_ACCOUNT_PW"\n'
        "fi\n"
    )
    proc = subprocess.run(
        ["docker", "exec", "-i", "-u", "zimbra", "-e", "LIVEIMAP_ADDR", "-e", "LIVEIMAP_ACCOUNT_PW", name, "/bin/bash", "-s"],
        input=inner, text=True, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    text = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode != 0 and "ACCOUNT_EXISTS" not in text and "already exists" not in text.lower():
        sys.stderr.write("account create failed\n")
        sys.exit(1)
PY
  "$DIR/zimbra-tls.sh" "liveimap-build-$server"
  set +e
  python3 - "$lab_host" "$host_port" "$DIR" "$server" <<'PY'
import imaplib
import ssl
import sys
import time

host, port_s, tools, server = sys.argv[1:]
sys.path.insert(0, tools)
import lab
user = lab.USER
secret = lab.PASS
port = int(port_s)
deadline = time.time() + 180
imap = None
last_oserror = ""
while time.time() < deadline:
    try:
        imap = imaplib.IMAP4(host, port, timeout=20)
        break
    except OSError as exc:
        last_oserror = str(exc).replace(secret, "***")
        time.sleep(2)
if imap is None:
    sys.stderr.write("bare login no greeting: %s\n" % last_oserror)
    sys.exit(1)
try:
    parts = []
    for item in imap.capabilities or []:
        if isinstance(item, bytes):
            parts.append(item.decode())
        else:
            parts.append(item)
    caps = " ".join(parts)
    if "LOGINDISABLED" in caps:
        ctx = ssl._create_unverified_context()
        imap.starttls(ctx)
    typ, data = imap.login(user, secret)
except Exception as exc:
    text = str(exc).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
if typ != "OK":
    text = str(data).replace(secret, "***")
    sys.stderr.write("bare login %s\n" % text)
    sys.exit(1)
try:
    imap.logout()
except Exception:
    pass
login_domain, expect = lab._imap_domain_columns(server)
if login_domain == "LAB_MAIL_DOMAIN":
    login_domain = lab.mail_domain()
if not login_domain or not expect:
    problem = lab.domain_login_problem({"name": server}, "")
else:
    account = user.split("@")[0] + "@" + login_domain
    caps = lab.plain_caps(port)
    if caps and "LOGINDISABLED" in caps:
        err = lab._starttls_login(port, account)
        reply = "OK" if not err else err
    else:
        reply = lab._plain_login_reply(port, account)
    problem = lab.domain_login_problem({"name": server}, reply)
if problem:
    sys.stderr.write(problem + "\n")
    sys.exit(1)
PY
  login_status=$?
