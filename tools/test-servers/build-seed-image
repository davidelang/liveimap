exec sleep infinity

EOF
chmod 755 "$CO_BUILD/entrypoint.sh"
cp "$DIR/images/courier-606/Dockerfile" "$CO_BUILD/Dockerfile"
  if [ "$tag" = liveimap-cyrus-3124:phase1 ]; then
    echo "building cyrus image"
    step "cyrus-3124 phase"
    python3 "$DIR/upstream_pins.py" dockerfile "$CY_BUILD/Dockerfile"
    HOME="$plugin_home" DOCKER_BUILDKIT=1 docker build ${SEED_NO_CACHE:+--no-cache} -t liveimap-cyrus-3124:phase1 --progress=plain "$CY_BUILD"
  fi
  if [ "$tag" = liveimap-courier-606:phase1 ]; then
    echo "building courier image"
    step "courier-606 phase"
    python3 "$DIR/upstream_pins.py" dockerfile "$CO_BUILD/Dockerfile"
    HOME="$plugin_home" DOCKER_BUILDKIT=1 docker build ${SEED_NO_CACHE:+--no-cache} -t liveimap-courier-606:phase1 --progress=plain "$CO_BUILD"
  fi
}

