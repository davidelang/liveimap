#!/usr/bin/env python3
"""Clean app/src/main/assets/settings-tree.json.

Git runs `clean` on stdin and stores the pretty bytes. There is no smudge filter.
"""
import sys

sys.dont_write_bytecode = True

import importlib.util
import json
from pathlib import Path


def _loads_settings_tree():
    path = Path(__file__).resolve().parent / "app" / "gen-settings-tree.py"
    spec = importlib.util.spec_from_file_location("gen_settings_tree", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.loads_settings_tree


loads_settings_tree = _loads_settings_tree()


def clean_text(text):
    doc = loads_settings_tree(text)
    return json.dumps(doc, indent=2, ensure_ascii=False) + "\n"


def main(argv):
    if len(argv) != 2 or argv[1] != "clean":
        sys.stderr.write("Usage: settings-tree-filter clean < tree.json\n")
        return 2
    try:
        text = sys.stdin.buffer.read().decode("utf-8")
        out = clean_text(text)
    except Exception as exc:
        sys.stderr.write("settings-tree-filter: %s\n" % exc)
        return 1
    sys.stdout.buffer.write(out.encode("utf-8"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
