# LiveIMAP build options for the libetpan pin: compile flags only, never upstreamed (patches/ holds code
# changes that could be offered upstream). The build script passes these to every ndk-build as APP_CFLAGS
# (through MAKEFLAGS) and forces a rebuild
# of the cached archives whenever this file changes.
#
# USE_SASL: host configure cannot see the Android Cyrus SASL headers, so without it mailimap_authenticate and
#   mailsmtp_auth_sasl are stubs.
# HAVE_SHA512: Cyrus SASL compiles SCRAM-SHA-256/-512 (and -PLUS) only with it; OpenSSL 3 provides SHA-2.
LIBETPAN_APP_CFLAGS="-DUSE_SASL=1 -DHAVE_SHA512=1"
