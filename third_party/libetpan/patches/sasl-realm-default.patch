--- a/src/low-level/imap/mailimap.c
+++ b/src/low-level/imap/mailimap.c
@@ -1734,7 +1734,10 @@
   switch (id) {
   case SASL_CB_GETREALM:
     if (result != NULL)
-      * result = session->imap_sasl.sasl_realm;
+      /* No realm configured: the server's first offered realm, else none. Cyrus's DIGEST-MD5 client
+         otherwise falls back to the server host name, and Dovecot logs the user in as user@host. */
+      * result = session->imap_sasl.sasl_realm != NULL ? session->imap_sasl.sasl_realm
+          : (availrealms != NULL && availrealms[0] != NULL) ? availrealms[0] : "";
     return SASL_OK;
   }
   
