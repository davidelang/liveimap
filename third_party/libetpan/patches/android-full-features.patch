+build_one() {
+  target_host=$1
+  android_arch=$2
+  configure_target=$3
+
+  if test -f Makefile ; then
+    make distclean
+  fi
+
+  export TARGET_HOST=$target_host
+  export ANDROID_ARCH=$android_arch
+
+  # NDK r28 clang rejects the implicit declarations in OpenSSL 1.1.1w.
+  ./Configure "$configure_target" no-shared no-engine \
+    -D__ANDROID_API__=$MIN_SDK_VERSION \
+    -Wno-error=implicit-function-declaration \
+    -Wno-error=int-conversion \
+    -Wno-error=incompatible-function-pointer-types \
+    --prefix="$PWD/build/$ANDROID_ARCH"
+
+  make -j5
+  make install_sw
+
+  libdir="$PWD/build/$ANDROID_ARCH/lib"
+  if test ! -f "$libdir/libssl.a" ; then
+    libdir="$PWD/build/$ANDROID_ARCH/lib64"
+  fi
+  if test ! -f "$libdir/libssl.a" || test ! -f "$libdir/libcrypto.a" ; then
+    echo "missing OpenSSL archives under $PWD/build/$ANDROID_ARCH" >&2
+    exit 1
+  fi
+
+  mkdir -p "./../$package_name-$build_version/libs/$android_arch"
+  if test ! -d "./../$package_name-$build_version/include" ; then
+    cp -R "$PWD/build/$ANDROID_ARCH/include" "./../$package_name-$build_version/include"
+  fi
+  cp "$libdir/libssl.a" "./../$package_name-$build_version/libs/$android_arch/libssl.a"
+  cp "$libdir/libcrypto.a" "./../$package_name-$build_version/libs/$android_arch/libcrypto.a"
+
+  make clean
+}
+
+# arm64 and x86_64 only.
+build_one aarch64-linux-android arm64-v8a android-arm64
+build_one x86_64-linux-android x86_64 android-x86_64
 
