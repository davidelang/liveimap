+LIBETPAN_EXPORT
+int mailimap_set_channel_binding(mailimap * session, const char * name,
+    const unsigned char * data, size_t len)
+{
+  char * name_copy;
+  unsigned char * data_copy;
+
+  if (name == NULL || data == NULL || len == 0) {
+    mailimap_channel_binding_clear(session);
+    return 0;
+  }
+
+  name_copy = strdup(name);
+  if (name_copy == NULL)
+    return MAILIMAP_ERROR_MEMORY;
+  data_copy = malloc(len);
+  if (data_copy == NULL) {
+    free(name_copy);
+    return MAILIMAP_ERROR_MEMORY;
+  }
+  memcpy(data_copy, data, len);
+
+  free(session->imap_sasl.sasl_cb_name);
+  free(session->imap_sasl.sasl_cb_data);
+  session->imap_sasl.sasl_cb_name = name_copy;
+  session->imap_sasl.sasl_cb_data = data_copy;
+  session->imap_sasl.sasl_cb_len = len;
+  return 0;
