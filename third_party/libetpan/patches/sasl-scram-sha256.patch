diff -ru a/build-android/build.sh b/build-android/build.sh
--- a/build-android/build.sh	2026-10-10 15:35:00.169641628 -0700
+++ b/build-android/build.sh	2026-10-10 15:35:00.197424780 -0700
@@ -3,7 +3,7 @@
 
 build_version=7
 openssl_build_version=3
-cyrus_sasl_build_version=4
+cyrus_sasl_build_version=5
 iconv_build_version=1
 package_name=libetpan-android
 
diff -ru a/build-android/dependencies/cyrus-sasl/build-android/jni/Android.mk b/build-android/dependencies/cyrus-sasl/build-android/jni/Android.mk
--- a/build-android/dependencies/cyrus-sasl/build-android/jni/Android.mk	2026-10-10 15:35:00.194357439 -0700
+++ b/build-android/dependencies/cyrus-sasl/build-android/jni/Android.mk	2026-10-10 15:35:00.200073634 -0700
@@ -52,5 +52,7 @@
    $(src_dir)/common \
    $(src_dir)/build-android/include $(OPENSSL_PATH)/include
 LOCAL_SRC_FILES := $(addprefix $(src_dir)/, $(src_files))
+# SCRAM-SHA-256/-512 (and their -PLUS forms) are compiled only with HAVE_SHA512; OpenSSL 3 provides SHA-2.
+LOCAL_CFLAGS += -DHAVE_SHA512=1
 
 include $(BUILD_STATIC_LIBRARY)
diff -ru a/build-android/dependencies/cyrus-sasl/build.sh b/build-android/dependencies/cyrus-sasl/build.sh
--- a/build-android/dependencies/cyrus-sasl/build.sh	2026-10-10 15:35:00.182712855 -0700
+++ b/build-android/dependencies/cyrus-sasl/build.sh	2026-10-10 15:35:00.198679224 -0700
@@ -6,7 +6,7 @@
 # to compile against the OpenSSL 1.1.1 we build below. This matches the version
 # already used by the iOS build.
 version=2.1.28
-build_version=4
+build_version=5
 ARCHIVE=cyrus-sasl-$version
 openssl_build_version=3
 package_name=cyrus-sasl-android
