diff --git a/b/unittest/imap/literal8_test.c b/unittest/imap/literal8_test.c
new file mode 100644
index 0000000..cba9cd4
--- /dev/null
+++ b/unittest/imap/literal8_test.c
@@ -0,0 +1,46 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "literal8_test.h"
+#include "imap_test_utils.h"
+#include "mailimap.h"
+#include "mailimap_parser.h"
+
+/* RFC 3516 literal8, as Stalwart sends it in a BINARY fetch response (recorded 2026-10-10):
+   "* 1 FETCH (UID 1 BINARY[1]<0> ~{22}" CRLF, then 22 octets. */
+int imap_literal8_test_run(void)
+{
+  static const char body[] = "Lab message 1 body.\r\n\0";
+  const size_t body_len = 22;
+  MMAPString * buffer = mmap_string_new("~{22}\r\n");
+  mmap_string_append_len(buffer, body, body_len);
+  mmap_string_append(buffer, ")\r\n");
+  mailstream * stream = imap_test_stream_from_string("");
+  mailimap * session = mailimap_new(0, NULL);
+  struct mailimap_parser_context * ctx = mailimap_parser_context_new(session);
+  size_t cur = 0;
+  char * text = NULL;
+  size_t len = 0;
+  int r = mailimap_nstring_parse(stream, buffer, ctx, &cur, &text, &len, 0, NULL);
+  assert(r == MAILIMAP_NO_ERROR);
+  assert(len == body_len);
+  assert(memcmp(text, body, body_len) == 0);
+  assert(buffer->str[cur] == ')');
+  mailimap_nstring_free(text);
+
+  /* An ordinary literal still parses. */
+  MMAPString * plain = mmap_string_new("{3}\r\nabc)");
+  cur = 0;
+  r = mailimap_nstring_parse(stream, plain, ctx, &cur, &text, &len, 0, NULL);
+  assert(r == MAILIMAP_NO_ERROR && len == 3 && memcmp(text, "abc", 3) == 0);
+  mailimap_nstring_free(text);
+
+  mmap_string_free(plain);
+  mmap_string_free(buffer);
+  mailimap_parser_context_free(ctx);
+  mailimap_free(session);
+  mailstream_close(stream);
+  puts("literal8_test: ok");
+  return 0;
+}
