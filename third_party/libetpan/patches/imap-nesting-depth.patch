Make the BODYSTRUCTURE parser safe against deep nesting.

A sender controls the MIME tree and the server mirrors it in BODYSTRUCTURE; mailimap_body_parse recursed once
per level, so a few thousand levels overflowed the stack. Parts deeper than MAILIMAP_BODY_MAX_DEPTH (128)
are now skipped iteratively (quoted strings and literals honoured) and returned as one
application/x-libetpan-too-deep part, so the rest of the response parses and section numbers stay right.
body-extension lists deeper than MAILIMAP_BODY_EXTENSION_MAX_DEPTH (32) are a parse error.

diff -ruN a/src/low-level/imap/mailimap_parser.c b/src/low-level/imap/mailimap_parser.c
--- a/src/low-level/imap/mailimap_parser.c
+++ b/src/low-level/imap/mailimap_parser.c
@@ -1973,6 +1973,96 @@
    body            = "(" (body-type-1part / body-type-mpart) ")"
 */
 
+/*
+  Skips the rest of a parenthesized body whose "(" was already consumed, up to (not including) the matching
+  ")", without recursion. Quoted strings and literals are parsed so their contents cannot unbalance it.
+*/
+static int mailimap_body_too_deep_skip(mailstream * fd, MMAPString * buffer,
+    struct mailimap_parser_context * parser_ctx, size_t * indx,
+    size_t progr_rate, progress_function * progr_fun)
+{
+  size_t cur_token;
+  size_t nest;
+  int r;
+
+  cur_token = * indx;
+  nest = 1;
+  while (1) {
+    char c;
+
+    if (cur_token >= buffer->len)
+      return MAILIMAP_ERROR_PARSE;
+    c = buffer->str[cur_token];
+    if (c == '"' || c == '{' || (c == '~' && cur_token + 1 < buffer->len && buffer->str[cur_token + 1] == '{')) {
+      char * value;
+
+      value = NULL;
+      r = mailimap_nstring_parse(fd, buffer, parser_ctx, &cur_token, &value, NULL, progr_rate, progr_fun);
+      if (r != MAILIMAP_NO_ERROR)
+        return r;
+      if (value != NULL)
+        mailimap_nstring_free(value);
+      continue;
+    }
+    if (c == '\r' || c == '\n')
+      return MAILIMAP_ERROR_PARSE;
+    if (c == '(') {
+      nest ++;
+    }
+    else if (c == ')') {
+      nest --;
+      if (nest == 0)
+        break;
+    }
+    cur_token ++;
+  }
+  * indx = cur_token;
+  return MAILIMAP_NO_ERROR;
+}
+
+static int mailimap_body_too_deep_part(struct mailimap_body_type_1part ** result)
+{
+  struct mailimap_media_basic * media;
+  struct mailimap_body_fld_enc * encoding;
+  struct mailimap_body_fields * fields;
+  struct mailimap_body_type_basic * basic;
+  struct mailimap_body_type_1part * part;
+  char * subtype;
+
+  subtype = strdup(MAILIMAP_BODY_TOO_DEEP_SUBTYPE);
+  if (subtype == NULL)
+    return MAILIMAP_ERROR_MEMORY;
+  media = mailimap_media_basic_new(MAILIMAP_MEDIA_BASIC_APPLICATION, NULL, subtype);
+  if (media == NULL) {
+    free(subtype);
+    return MAILIMAP_ERROR_MEMORY;
+  }
+  encoding = mailimap_body_fld_enc_new(MAILIMAP_BODY_FLD_ENC_7BIT, NULL);
+  if (encoding == NULL) {
+    mailimap_media_basic_free(media);
+    return MAILIMAP_ERROR_MEMORY;
+  }
+  fields = mailimap_body_fields_new(NULL, NULL, NULL, encoding, 0);
+  if (fields == NULL) {
+    mailimap_body_fld_enc_free(encoding);
+    mailimap_media_basic_free(media);
+    return MAILIMAP_ERROR_MEMORY;
+  }
+  basic = mailimap_body_type_basic_new(media, fields);
+  if (basic == NULL) {
+    mailimap_body_fields_free(fields);
+    mailimap_media_basic_free(media);
+    return MAILIMAP_ERROR_MEMORY;
+  }
+  part = mailimap_body_type_1part_new(MAILIMAP_BODY_TYPE_1PART_BASIC, basic, NULL, NULL, NULL);
+  if (part == NULL) {
+    mailimap_body_type_basic_free(basic);
+    return MAILIMAP_ERROR_MEMORY;
+  }
+  * result = part;
+  return MAILIMAP_NO_ERROR;
+}
+
 static int mailimap_body_parse(mailstream * fd, MMAPString * buffer, struct mailimap_parser_context * parser_ctx,
 			       size_t * indx,
 			       struct mailimap_body ** result,
@@ -2000,18 +2090,33 @@
 
   type = MAILIMAP_BODY_ERROR; /* XXX - removes a gcc warning */
 
