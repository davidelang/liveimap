+					 &body_type_mpart,
+					 progr_rate, progr_fun);
+
+      if (r == MAILIMAP_NO_ERROR)
+        type = MAILIMAP_BODY_MPART;
+    }
+
+    if (parser_ctx != NULL)
+      parser_ctx->body_depth --;
   }
 
   if (r != MAILIMAP_NO_ERROR) {
@@ -2157,9 +2262,17 @@
