+    r = mailimap_body_too_deep_skip(fd, buffer, parser_ctx, &cur_token, progr_rate, progr_fun);
+    if (r == MAILIMAP_NO_ERROR)
+      r = mailimap_body_too_deep_part(&body_type_1part);
+    if (r == MAILIMAP_NO_ERROR)
