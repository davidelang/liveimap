+LIBETPAN_EXPORT
+void mailstream_set_max_line_length(mailstream * s, size_t max_line_length);
+
+LIBETPAN_EXPORT
+size_t mailstream_get_max_line_length(mailstream * s);
+
 LIBETPAN_EXPORT
 ssize_t mailstream_write(mailstream * s, const void * buf, size_t count);
 
