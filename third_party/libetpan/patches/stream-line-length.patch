 char * mailstream_read_line_append(mailstream * stream, MMAPString * line)
 {
+  size_t start;
+
   if (stream == NULL)
     return NULL;
 
+  start = line->len;
   do {
     if (stream->read_buffer_len > 0) {
       size_t i;
+      size_t take;
 
       i = 0;
-      while (i < stream->read_buffer_len) {
-        if (stream->read_buffer[i] == '\n')
-          return mailstream_read_len_append(stream, line, i + 1);
+      while (i < stream->read_buffer_len && stream->read_buffer[i] != '\n')
         i++;
-      }
+      take = (i < stream->read_buffer_len) ? i + 1 : stream->read_buffer_len;
+      /* A hostile peer could otherwise grow one line until memory runs out. */
+      if (stream->max_line_length != 0 && line->len - start + take > stream->max_line_length)
+        return NULL;
+      if (i < stream->read_buffer_len)
