diff -ruN a/unittest/imap/line_length_test.c b/unittest/imap/line_length_test.c
--- a/unittest/imap/line_length_test.c
+++ b/unittest/imap/line_length_test.c
@@ -0,0 +1,55 @@
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "line_length_test.h"
+#include "imap_test_utils.h"
+#include "mailstream.h"
+#include "mmapstring.h"
+
+/* A server must not be able to make the client buffer an endless line. */
+int imap_line_length_test_run(void)
+{
+  MMAPString * line = mmap_string_new("");
+  char * big = malloc(5001);
+  mailstream * s;
+
+  memset(big, 'x', 5000);
+  big[5000] = 0;
+
+  /* The default limit exists and is generous. */
+  s = imap_test_stream_from_string("* OK hi\r\n");
+  assert(mailstream_get_max_line_length(s) == MAILSTREAM_DEFAULT_MAX_LINE_LENGTH);
+  assert(mailstream_read_line(s, line) != NULL && strcmp(line->str, "* OK hi\r\n") == 0);
+  mailstream_close(s);
+
+  /* Over the limit, with or without a newline in sight: the read fails. */
+  s = imap_test_stream_from_string(big);
+  mailstream_set_max_line_length(s, 1000);
+  assert(mailstream_read_line(s, line) == NULL);
+  mailstream_close(s);
+
+  /* Exactly at the limit (newline included) still reads; the next line is separate. */
+  {
+    char text[64];
+    memset(text, 'y', 18);
+    memcpy(text + 18, "\r\n* OK next\r\n", 14);
+    s = imap_test_stream_from_string(text);
+    mailstream_set_max_line_length(s, 20);
+    assert(mailstream_read_line(s, line) != NULL && line->len == 20);
+    assert(mailstream_read_line(s, line) != NULL && strcmp(line->str, "* OK next\r\n") == 0);
+    mailstream_close(s);
+  }
+
+  /* 0 means no limit. */
+  s = imap_test_stream_from_string(big);
+  mailstream_set_max_line_length(s, 0);
+  assert(mailstream_read_line(s, line) != NULL && line->len == 5000);
+  mailstream_close(s);
+
+  free(big);
+  mmap_string_free(line);
+  puts("line_length_test: ok");
+  return 0;
+}
