<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- F03: AccountSetupActivity hides other apps' overlays while it is shown (normal permission, API 31+). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- F70: let the support button see mail apps and the help links see a browser (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="message/rfc822" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: JMAP over http only to the origin the user typed (JmapPlainHttp gates every URL; David: never refuse the user). -->
    <application
        android:name="org.dlang.liveimap.LiveImapApplication"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <meta-data android:name="liveimap.gitCommit" android:value="${gitCommit}" />

        <!-- Eight windows, eight process names. The launcher does not take a slot. -->
        <activity
            android:name="org.dlang.liveimap.window.LauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A turn or a move to another display does not recreate the window. -->
        <activity
            android:name="org.dlang.liveimap.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w0"
            android:taskAffinity="com.davidlang.liveimap.w0" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity1"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w1"
            android:taskAffinity="com.davidlang.liveimap.w1" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity2"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w2"
            android:taskAffinity="com.davidlang.liveimap.w2" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity3"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w3"
            android:taskAffinity="com.davidlang.liveimap.w3" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity4"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w4"
            android:taskAffinity="com.davidlang.liveimap.w4" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity5"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w5"
            android:taskAffinity="com.davidlang.liveimap.w5" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity6"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w6"
            android:taskAffinity="com.davidlang.liveimap.w6" />
        <activity
            android:name="org.dlang.liveimap.window.WindowActivity7"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":w7"
            android:taskAffinity="com.davidlang.liveimap.w7" />

        <provider
            android:name="org.dlang.liveimap.engine.TrafficFileProvider"
            android:authorities="com.davidlang.liveimap.trafficlog"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name="org.dlang.liveimap.ui.reader.AttachmentFileProvider"
            android:authorities="com.davidlang.liveimap.attachments"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name="org.dlang.liveimap.accounts.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <activity
            android:name="org.dlang.liveimap.accounts.AccountSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true" />
    </application>
</manifest>
